Функция ВыполнитьЗапрос(Настройки, Тело)

	Ответ = Новый Структура("Код, Текст, Данные, Заголовки, Ошибка", 0, "", Неопределено, Новый Соответствие, "");
	Адрес = РазобратьАдрес(Настройки.АдресAPI);
	Попытка
		ЗащищенноеСоединение = Неопределено;
		Если Адрес.Защищенное Тогда
			ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(, Новый СертификатыУдостоверяющихЦентровОС);
		КонецЕсли;
		Прокси = Неопределено;
		Если Не Адрес.Локальный Тогда
			Прокси = ПолучениеФайловИзИнтернета.ПолучитьПрокси(?(Адрес.Защищенное, "https", "http"));
		КонецЕсли;
		Соединение = Новый HTTPСоединение(Адрес.Хост, Адрес.Порт, , , Прокси, Настройки.ТаймаутСекунд, ЗащищенноеСоединение);
		HTTPЗапрос = Новый HTTPЗапрос(Адрес.Префикс + "/v1/messages");
		HTTPЗапрос.Заголовки.Вставить("x-api-key", СокрЛП(Настройки.КлючAPI));
		HTTPЗапрос.Заголовки.Вставить("anthropic-version", ВерсияAPI());
		HTTPЗапрос.Заголовки.Вставить("content-type", "application/json");
		Если Настройки.РезервнаяМодель Тогда
			HTTPЗапрос.Заголовки.Вставить("anthropic-beta", "server-side-fallback-2026-07-01");
		КонецЕсли;
		HTTPЗапрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		HTTPОтвет = Соединение.ВызватьHTTPМетод("POST", HTTPЗапрос);
		Ответ.Код = HTTPОтвет.КодСостояния;
		Ответ.Текст = HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		Для Каждого Заголовок Из HTTPОтвет.Заголовки Цикл
			Ответ.Заголовки.Вставить(НРег(Заголовок.Ключ), Заголовок.Значение);
		КонецЦикла;
		Ответ.Данные = ИзJSON(Ответ.Текст);
	Исключение
		Ответ.Код = 0;
		Ответ.Ошибка = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Ответ;

КонецФункции

// Что делать с ответом: разобрать, повторить позже, записать ошибку документа или остановить всё.
Функция ОценитьОтвет(Ответ, Попыток)

	Решение = Новый Структура("Действие, ПаузаМс, Текст", "Обработать", 0, "");
	Код = Ответ.Код;
	Если Код >= 200 И Код < 300 Тогда
		Возврат Решение;
	КонецЕсли;
	Причина = ТекстОшибкиAPI(Ответ);
	Если Код = 0 Тогда
		Решение.Действие = "Повторить";
		Решение.ПаузаМс = ПаузаПовтора(Попыток);
		Решение.Текст = СтрШаблон(НСтр("ru = 'нет связи с API (%1), повтор через %2 с'"), Ответ.Ошибка, Решение.ПаузаМс / 1000);
	ИначеЕсли Код = 429 Тогда
		Секунд = ЧислоИзСтроки(Ответ.Заголовки.Получить("retry-after"));
		Решение.Действие = "Повторить";
		Решение.ПаузаМс = ?(Секунд > 0, Секунд * 1000 + 100, ПаузаПовтора(Попыток));
		Решение.Текст = СтрШаблон(НСтр("ru = 'лимит запросов API, пауза %1 с'"), Формат(Решение.ПаузаМс / 1000, "ЧДЦ=1; ЧН=0"));
	ИначеЕсли Код = 529 Или Код >= 500 Или Код = 408 Тогда
		Решение.Действие = "Повторить";
		Решение.ПаузаМс = ПаузаПовтора(Попыток);
		Решение.Текст = СтрШаблон(НСтр("ru = 'API ответил %1 (%2), повтор через %3 с'"), Код, Причина, Решение.ПаузаМс / 1000);
	ИначеЕсли Код = 401 Тогда
		Решение.Действие = "Остановить";
		Решение.Текст = СтрШаблон(НСтр("ru = 'API не принял ключ (401: %1). Проверьте ключ в настройках, его выдают в консоли Anthropic в разделе API keys'"), Причина);
	ИначеЕсли Код = 403 Тогда
		Решение.Действие = "Остановить";
		Решение.Текст = СтрШаблон(НСтр("ru = 'Нет доступа к API (403: %1)'"), Причина);
	ИначеЕсли Код = 413 Тогда
		Решение.Действие = "ОшибкаФайла";
		Решение.Текст = НСтр("ru = 'Файл больше лимита запроса API: разделите PDF на части'");
	Иначе
		Решение.Действие = "ОшибкаФайла";
		Решение.Текст = СтрШаблон(НСтр("ru = 'API отклонил запрос (%1): %2'"), Код, Причина);
	КонецЕсли;
	Возврат Решение;

КонецФункции

Функция ТекстОшибкиAPI(Ответ)

	Ошибка = Поле(Ответ.Данные, "error");
	Текст = Поле(Ошибка, "message", "");
	Если ПустаяСтрока(Текст) Тогда
		Текст = Лев(СокрЛП(Ответ.Текст), 300);
	КонецЕсли;
	Ид = Поле(Ответ.Данные, "request_id", "");
	Возврат Текст + ?(ПустаяСтрока(Ид), "", ", request_id " + Ид);

КонецФункции

Функция ПаузаПовтора(Попыток)

	Пауза = 2000;
	Для Счетчик = 1 По Попыток Цикл
		Пауза = Пауза * 2;
	КонецЦикла;
	Возврат Мин(Пауза, 60000);

