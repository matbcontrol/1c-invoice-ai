Функция РазобратьАдрес(Знач Адрес)

	Результат = Новый Структура("Хост, Порт, Защищенное, Префикс, Локальный", "", 443, Истина, "", Ложь);
	Адрес = СокрЛП(Адрес);
	Если СтрНачинаетсяС(НРег(Адрес), "http://") Тогда
		Результат.Защищенное = Ложь;
		Результат.Порт = 80;
		Адрес = Сред(Адрес, 8);
	ИначеЕсли СтрНачинаетсяС(НРег(Адрес), "https://") Тогда
		Адрес = Сред(Адрес, 9);
	КонецЕсли;
	Позиция = СтрНайти(Адрес, "/");
	Если Позиция > 0 Тогда
		Результат.Префикс = Сред(Адрес, Позиция);
		Адрес = Лев(Адрес, Позиция - 1);
	КонецЕсли;
	Если СтрЗаканчиваетсяНа(Результат.Префикс, "/") Тогда
		Результат.Префикс = Лев(Результат.Префикс, СтрДлина(Результат.Префикс) - 1);
	КонецЕсли;
	Позиция = СтрНайти(Адрес, ":");
	Если Позиция > 0 Тогда
		Результат.Порт = Число(Сред(Адрес, Позиция + 1));
		Адрес = Лев(Адрес, Позиция - 1);
	КонецЕсли;
	Результат.Хост = Адрес;
	Результат.Локальный = (Адрес = "localhost" Или Адрес = "127.0.0.1");
	Возврат Результат;

КонецФункции

