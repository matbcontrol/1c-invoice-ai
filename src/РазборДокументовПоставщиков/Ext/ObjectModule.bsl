// Тело запроса к Messages API: PDF документом в base64, ответ строго по JSON-схеме,
// резервная модель на случай отказа. Экспортируется, чтобы тесты проверяли запрос.
Функция ТелоЗапроса(ДанныеPDF, Настройки) Экспорт

	// Base64Строка переносит строку каждые 76 символов, а API принимает base64 без переносов.
	Данные = СтрЗаменить(СтрЗаменить(Base64Строка(ДанныеPDF), Символы.ВК, ""), Символы.ПС, "");

	Источник = Новый Структура("type, media_type, data", "base64", "application/pdf", Данные);
	Содержимое = Новый Массив;
	Содержимое.Добавить(Новый Структура("type, source", "document", Источник));
	Содержимое.Добавить(Новый Структура("type, text", "text", ТекстЗадания()));
	Сообщения = Новый Массив;
	Сообщения.Добавить(Новый Структура("role, content", "user", Содержимое));

	Тело = Новый Структура;
	Тело.Вставить("model", Настройки.Модель);
	Тело.Вставить("max_tokens", Настройки.МаксТокенов);
	Тело.Вставить("system", СистемныйПромпт());
	Тело.Вставить("output_config", Новый Структура("effort, format", Настройки.Усилие,
		Новый Структура("type, schema", "json_schema", СхемаОтвета())));
	Если Настройки.РезервнаяМодель Тогда
		// При отказе классификатора API сам повторит запрос на рекомендованной резервной модели.
		Тело.Вставить("fallbacks", "default");
	КонецЕсли;
	Тело.Вставить("messages", Сообщения);
	Возврат ВJSON(Тело);

КонецФункции

// JSON-схема ответа модели. Все объекты закрыты (additionalProperties = false), как требует API.
Функция СхемаОтвета() Экспорт

	Сторона = ОбъектСхемы();
	ДобавитьСвойство(Сторона, "name", ПолеСхемы("string", "Наименование как в документе"));
	ДобавитьСвойство(Сторона, "inn", ПолеСхемы("string", "ИНН цифрами, посимвольно как в документе"));
	ДобавитьСвойство(Сторона, "kpp", ПолеСхемы("string", "КПП цифрами, пустая строка если нет"));

	Строка = ОбъектСхемы();
	ДобавитьСвойство(Строка, "line_no", ПолеСхемы("integer", "Номер строки в документе"));
	ДобавитьСвойство(Строка, "supplier_code", ПолеСхемы("string", "Код или артикул товара у поставщика, пустая строка если нет"));
	ДобавитьСвойство(Строка, "name", ПолеСхемы("string", "Наименование товара как в документе"));
	ДобавитьСвойство(Строка, "barcode", ПолеСхемы("string", "Штрихкод, если напечатан, иначе пустая строка"));
	ДобавитьСвойство(Строка, "unit", ПолеСхемы("string", "Условное обозначение единицы измерения"));
	ДобавитьСвойство(Строка, "okei", ПолеСхемы("string", "Код единицы по ОКЕИ, пустая строка если нет"));
	ДобавитьСвойство(Строка, "quantity", ПолеСхемы("number", "Количество"));
	ДобавитьСвойство(Строка, "price", ПолеСхемы("number", "Цена за единицу как в документе"));
	ДобавитьСвойство(Строка, "amount", ПолеСхемы("number", "Сумма строки как в документе: без налога в УПД, с налогом если цены с НДС"));
	ДобавитьСвойство(Строка, "vat_rate", ПолеПеречисления(СтрРазделить("22%,20%,10%,7%,5%,0%,без НДС", ","), "Ставка НДС"));
	ДобавитьСвойство(Строка, "vat_amount", ПолеСхемы("number", "Сумма НДС по строке"));
	ДобавитьСвойство(Строка, "amount_with_vat", ПолеСхемы("number", "Стоимость строки с налогом"));

	Схема = ОбъектСхемы();
	ДобавитьСвойство(Схема, "document_type", ПолеПеречисления(СтрРазделить("upd,invoice_for_payment,torg12,other", ","), "Вид документа"));
	ДобавитьСвойство(Схема, "number", ПолеСхемы("string", "Номер документа"));
	ДобавитьСвойство(Схема, "date", Новый Структура("type, format, description", "string", "date", "Дата документа ГГГГ-ММ-ДД"));
	ДобавитьСвойство(Схема, "seller", Сторона);
	ДобавитьСвойство(Схема, "buyer", Сторона);
	ДобавитьСвойство(Схема, "currency", ПолеСхемы("string", "Код валюты, например RUB"));
	ДобавитьСвойство(Схема, "prices_include_vat", ПолеСхемы("boolean", "Цены и суммы в строках указаны с НДС"));
	ДобавитьСвойство(Схема, "lines", Новый Структура("type, items", "array", Строка));
	ДобавитьСвойство(Схема, "total_without_vat", ПолеСхемы("number", "Итого без НДС"));
	ДобавитьСвойство(Схема, "total_vat", ПолеСхемы("number", "Итого НДС"));
	ДобавитьСвойство(Схема, "total_with_vat", ПолеСхемы("number", "Всего к оплате с НДС"));
	ДобавитьСвойство(Схема, "unreadable", Новый Структура("type, items, description", "array", ПолеСхемы("string", ""),
		"Что прочитано неуверенно: поле и причина. Пустой список, если всё читается"));
	Возврат Схема;

КонецФункции

// Контрольная сумма ИНН по правилам ФНС: 10 цифр у организации, 12 у ИП и физлица.
Функция ИННКорректен(Знач ИНН) Экспорт

	ИНН = СокрЛП(ИНН);
	Длина = СтрДлина(ИНН);
	Если Длина <> 10 И Длина <> 12 Тогда
		Возврат Ложь;
	КонецЕсли;
	Цифры = Новый Массив;
	Для Позиция = 1 По Длина Цикл
		Символ = Сред(ИНН, Позиция, 1);
		Если СтрНайти("0123456789", Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Цифры.Добавить(Число(Символ));
	КонецЦикла;
	Если Длина = 10 Тогда
		Возврат КонтрольнаяЦифра(Цифры, "2,4,10,3,5,9,4,6,8") = Цифры[9];
	КонецЕсли;
	Возврат КонтрольнаяЦифра(Цифры, "7,2,4,10,3,5,9,4,6,8") = Цифры[10]
		И КонтрольнаяЦифра(Цифры, "3,7,2,4,10,3,5,9,4,6,8") = Цифры[11];

КонецФункции

// Текст для сравнения наименований: регистр, ё, кавычки и лишние пробелы не учитываются.
Функция НормализоватьТекст(Знач Текст) Экспорт

	Текст = НРег(СокрЛП(Текст));
	Текст = СтрЗаменить(Текст, "ё", "е");
	Для Каждого Кавычка Из СтрРазделить("""|«|»|„|“|”|'", "|") Цикл
		Текст = СтрЗаменить(Текст, Кавычка, "");
	КонецЦикла;
	Для Каждого Пробел Из СтрРазделить(Символы.НПП + "|" + Символы.Таб + "|" + Символы.ПС + "|" + Символы.ВК, "|") Цикл
		Текст = СтрЗаменить(Текст, Пробел, " ");
	КонецЦикла;
	Пока СтрНайти(Текст, "  ") > 0 Цикл
		Текст = СтрЗаменить(Текст, "  ", " ");
	КонецЦикла;
	Текст = СокрЛП(СтрЗаменить(СтрЗаменить(Текст, " ,", ","), "( ", "("));
	Если СтрЗаканчиваетсяНа(Текст, ".") Тогда
		Текст = Лев(Текст, СтрДлина(Текст) - 1);
	КонецЕсли;
	Возврат Текст;

КонецФункции

// Ошибка арифметики строки или пустая строка. Цена в документе округлена до копеек,
// поэтому количество на цену может отличаться от суммы на полкопейки на единицу.
Функция ОшибкаАрифметикиСтроки(Строка, ЦеныСНДС) Экспорт

	Расчет = Строка.Количество * Строка.Цена;
	Допуск = Макс(0.01, Строка.Количество * 0.005);
	Если Макс(Расчет - Строка.Сумма, Строка.Сумма - Расчет) > Допуск Тогда
		Возврат СтрШаблон(НСтр("ru = '%1 × %2 = %3, а в документе %4'"), Строка.Количество, ФорматСуммы(Строка.Цена),
			ФорматСуммы(Окр(Расчет, 2)), ФорматСуммы(Строка.Сумма));
	КонецЕсли;
	Ставка = СтавкаЧислом(Строка.СтавкаНДС);
	Если Ставка = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	НДС = ?(ЦеныСНДС, Окр(Строка.Сумма * Ставка / (100 + Ставка), 2), Окр(Строка.Сумма * Ставка / 100, 2));
	Если Макс(НДС - Строка.СуммаНДС, Строка.СуммаНДС - НДС) > 0.01 Тогда
		Возврат СтрШаблон(НСтр("ru = 'НДС %1 от %2 равен %3, а в документе %4'"), Строка.СтавкаНДС, ФорматСуммы(Строка.Сумма),
			ФорматСуммы(НДС), ФорматСуммы(Строка.СуммаНДС));
	КонецЕсли;
	Всего = ?(ЦеныСНДС, Строка.Сумма, Строка.Сумма + Строка.СуммаНДС);
	Если Макс(Всего - Строка.Всего, Строка.Всего - Всего) > 0.01 Тогда
		Возврат СтрШаблон(НСтр("ru = 'стоимость с налогом %1, а в документе %2'"), ФорматСуммы(Всего), ФорматСуммы(Строка.Всего));
	КонецЕсли;
	Возврат "";

КонецФункции

