#КонецОбласти

#Область РазборОтвета

Процедура РазобратьОтвет(Состояние, Элемент, Ответ)

	Данные = Ответ.Данные;
	Причина = Поле(Данные, "stop_reason", "");
	Если Причина = "refusal" Тогда
		Детали = Поле(Данные, "stop_details");
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Модель отказалась разбирать документ (%1)'"),
			СокрЛП(Строка(Поле(Детали, "category", "")) + " " + Поле(Детали, "explanation", "")));
	ИначеЕсли Причина = "max_tokens" Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Ответ модели обрезан по лимиту %1 токенов: увеличьте «Макс. токенов» или разделите документ'"),
			Формат(Состояние.Настройки.МаксТокенов, "ЧГ=0"));
	КонецЕсли;
	Текст = "";
	Резервная = Ложь;
	Для Каждого Блок Из Поле(Данные, "content", Новый Массив) Цикл
		Тип = Поле(Блок, "type", "");
		Если Тип = "text" Тогда
			Текст = Поле(Блок, "text", "");
		ИначеЕсли Тип = "fallback" Тогда
			Резервная = Истина;
		КонецЕсли;
	КонецЦикла;
	Результат = ИзJSON(Текст);
	Если ТипЗнч(Результат) <> Тип("Соответствие") Или ТипЗнч(Поле(Результат, "lines")) <> Тип("Массив") Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Ответ модели не разобран как JSON по схеме: %1'"), Лев(Текст, 200));
	КонецЕсли;

	Документ = Состояние.Документы.Добавить();
	Документ.ИдФайла = Элемент.ИдФайла;
	Документ.Файл = Элемент.Имя;
	Виды = Новый Соответствие;
	Виды.Вставить("upd", "УПД");
	Виды.Вставить("invoice_for_payment", "Счёт на оплату");
	Виды.Вставить("torg12", "ТОРГ-12");
	Вид = Виды.Получить(Поле(Результат, "document_type", ""));
	Документ.Тип = ?(Вид = Неопределено, НСтр("ru = 'Другой'"), Вид);
	Документ.Номер = СокрЛП(Поле(Результат, "number", ""));
	Документ.Дата = ДатаИзISO(Поле(Результат, "date", ""));
	Продавец = Поле(Результат, "seller");
	Покупатель = Поле(Результат, "buyer");
	Документ.ПродавецНаименование = Поле(Продавец, "name", "");
	Документ.ПродавецИНН = ТолькоЦифры(Поле(Продавец, "inn", ""));
	Документ.ПродавецКПП = ТолькоЦифры(Поле(Продавец, "kpp", ""));
	Документ.ПокупательНаименование = Поле(Покупатель, "name", "");
	Документ.ПокупательИНН = ТолькоЦифры(Поле(Покупатель, "inn", ""));
	Документ.ЦеныСНДС = Поле(Результат, "prices_include_vat", Ложь) = Истина;
	Документ.СуммаБезНДС = Число(Поле(Результат, "total_without_vat", 0));
	Документ.СуммаНДС = Число(Поле(Результат, "total_vat", 0));
	Документ.Всего = Число(Поле(Результат, "total_with_vat", 0));
	Документ.Нечитаемо = СтрСоединить(Поле(Результат, "unreadable", Новый Массив), "; ");
	Документ.Модель = Поле(Данные, "model", "");
	Использовано = Поле(Данные, "usage");
	Документ.ТокеновВход = Число(Поле(Использовано, "input_tokens", 0));
	Документ.ТокеновВыход = Число(Поле(Использовано, "output_tokens", 0));
	Если Резервная Тогда
		ДобавитьСообщение(Состояние, СтрШаблон(НСтр("ru = '%1: основная модель отказалась, ответила резервная %2'"), Элемент.Имя, Документ.Модель));
	КонецЕсли;

	Номер = 0;
	Для Каждого Позиция Из Поле(Результат, "lines", Новый Массив) Цикл
		Номер = Номер + 1;
		СтрокаДокумента = Состояние.Строки.Добавить();
		СтрокаДокумента.ИдФайла = Элемент.ИдФайла;
		СтрокаДокумента.НомерСтроки = Число(Поле(Позиция, "line_no", Номер));
		СтрокаДокумента.КодПоставщика = СокрЛП(Поле(Позиция, "supplier_code", ""));
		СтрокаДокумента.Наименование = СокрЛП(Поле(Позиция, "name", ""));
		СтрокаДокумента.Штрихкод = ТолькоЦифры(Поле(Позиция, "barcode", ""));
		СтрокаДокумента.Единица = Поле(Позиция, "unit", "");
		СтрокаДокумента.ОКЕИ = ТолькоЦифры(Поле(Позиция, "okei", ""));
		СтрокаДокумента.Количество = Число(Поле(Позиция, "quantity", 0));
		СтрокаДокумента.Цена = Число(Поле(Позиция, "price", 0));
		СтрокаДокумента.Сумма = Число(Поле(Позиция, "amount", 0));
		СтрокаДокумента.СтавкаНДС = Поле(Позиция, "vat_rate", "");
		СтрокаДокумента.СуммаНДС = Число(Поле(Позиция, "vat_amount", 0));
		СтрокаДокумента.Всего = Число(Поле(Позиция, "amount_with_vat", 0));
	КонецЦикла;
	Документ.Строк = Номер;

КонецПроцедуры

Процедура ДобавитьОшибкуФайла(Состояние, Элемент, Текст)

	Документ = Состояние.Документы.Добавить();
	Документ.ИдФайла = Элемент.ИдФайла;
	Документ.Файл = Элемент.Имя;
	Документ.Статус = "Ошибка разбора";
	Документ.Пояснение = Текст;
	ЗаписьЖурналаРегистрации(СобытиеЖурнала(), УровеньЖурналаРегистрации.Ошибка, , , Элемент.Имя + ": " + Текст);

КонецПроцедуры

#КонецОбласти

#Область Проверки

// Поставщики по ИНН (и КПП, если он есть и в документе, и в 1С).
Функция ПоставщикиПоИНН(ДокументыРазбора)

	ИНН = Новый Массив;
	Для Каждого Документ Из ДокументыРазбора Цикл
		Если ИННКорректен(Документ.ПродавецИНН) Тогда
			ИНН.Добавить(Документ.ПродавецИНН);
		КонецЕсли;
	КонецЦикла;
	Результат = Новый Соответствие;
	Если ИНН.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Ссылка,
	|	Контрагенты.ИНН КАК ИНН,
	|	Контрагенты.КПП КАК КПП
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН В (&ИНН)
	|	И НЕ Контрагенты.ПометкаУдаления
	|	И НЕ Контрагенты.ЭтоГруппа
	|
	|УПОРЯДОЧИТЬ ПО
	|	Контрагенты.Поставщик УБЫВ,
	|	Контрагенты.Код");
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Ключ без КПП: если в 1С у контрагента КПП не заполнен, его находят по одному ИНН.
		Если Результат.Получить(КлючПоставщика(Выборка.ИНН, "")) = Неопределено Тогда
			Результат.Вставить(КлючПоставщика(Выборка.ИНН, ""), Выборка.Ссылка);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.КПП) Тогда
			Результат.Вставить(КлючПоставщика(Выборка.ИНН, Выборка.КПП), Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	// Документ с КПП ищет сначала точное совпадение, потом контрагента без КПП.
	Для Каждого Документ Из ДокументыРазбора Цикл
		Ключ = КлючПоставщика(Документ.ПродавецИНН, Документ.ПродавецКПП);
		Если Результат.Получить(Ключ) = Неопределено И Результат.Получить(КлючПоставщика(Документ.ПродавецИНН, "")) <> Неопределено Тогда
			Результат.Вставить(Ключ, Результат.Получить(КлючПоставщика(Документ.ПродавецИНН, "")));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция КлючПоставщика(ИНН, КПП)
	Возврат СокрЛП(ИНН) + "/" + СокрЛП(КПП);
КонецФункции

// Уже загруженные приходные накладные: поставщик + номер входящего документа.
// Источник: таблица документов разбора или одна её строка (перед записью в транзакции).
Функция ЗагруженныеДокументы(Источник, Поставщики)

	Пары = Новый ТаблицаЗначений;
	Пары.Колонки.Добавить("Поставщик", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	Пары.Колонки.Добавить("Номер", ОписаниеСтроки(50));
	Если ТипЗнч(Источник) = Тип("ТаблицаЗначений") Тогда
		Для Каждого Документ Из Источник Цикл
			Поставщик = Неопределено;
			Если Поставщики <> Неопределено И ИННКорректен(Документ.ПродавецИНН) Тогда
				Поставщик = Поставщики.Получить(КлючПоставщика(Документ.ПродавецИНН, Документ.ПродавецКПП));
			КонецЕсли;
			Если Поставщик <> Неопределено И Не ПустаяСтрока(Документ.Номер) Тогда
				Пара = Пары.Добавить();
				Пара.Поставщик = Поставщик;
				Пара.Номер = Документ.Номер;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Пара = Пары.Добавить();
		Пара.Поставщик = Источник.Поставщик;
		Пара.Номер = Источник.Номер;
	КонецЕсли;
	Результат = Новый Соответствие;
	Если Пары.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Пары.Поставщик КАК Поставщик,
	|	Пары.Номер КАК Номер
	|ПОМЕСТИТЬ Пары
	|ИЗ
	|	&Пары КАК Пары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Накладные.Ссылка КАК Ссылка,
	|	Накладные.Контрагент КАК Поставщик,
	|	Накладные.НомерВходящегоДокумента КАК Номер
	|ИЗ
	|	Документ.ПриходнаяНакладная КАК Накладные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Пары КАК Пары
	|		ПО Накладные.Контрагент = Пары.Поставщик
	|			И Накладные.НомерВходящегоДокумента = Пары.Номер
	|ГДЕ
	|	НЕ Накладные.ПометкаУдаления");
	Запрос.УстановитьПараметр("Пары", Пары);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(КлючДокумента(Выборка.Поставщик, Выборка.Номер), Выборка.Ссылка);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция КлючДокумента(Поставщик, Номер)
	Возврат XMLСтрока(Поставщик) + "|" + НРег(СокрЛП(Номер));
КонецФункции

Функция ХудшийСтатус(Текущий, Новый1)

	Порядок = СтрРазделить("Готов,Нужно сопоставить,Новый поставщик,Проверить,Уже загружен,Проверить ИНН,Не наш документ,Ошибка разбора", ",");
	Возврат ?(Порядок.Найти(Новый1) > Порядок.Найти(Текущий), Новый1, Текущий);

КонецФункции

Функция СтавкаЧислом(Ставка)

	Текст = НРег(СокрЛП(Ставка));
	Если Текст = "без ндс" Тогда
		Возврат 0;
	КонецЕсли;
	Текст = СтрЗаменить(Текст, "%", "");
	Значение = ЧислоИзСтроки(Текст);
	Если Значение = 0 И Текст <> "0" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Элемент справочника «Ставки НДС» по ставке из документа: «22%» -> «22%», «без НДС» -> «Без НДС».
Функция СтавкаНДС(Ставка)

	Наименование = ?(НРег(СокрЛП(Ставка)) = "без ндс", "Без НДС", СокрЛП(Ставка));
	Если ПустаяСтрока(Наименование) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Найдена = Справочники.СтавкиНДС.НайтиПоНаименованию(Наименование, Истина);
	Возврат ?(ЗначениеЗаполнено(Найдена), Найдена, Неопределено);

КонецФункции

#КонецОбласти

#Область СопоставлениеТоваров

// Товары 1С для строк: соответствие поставщика -> штрихкод -> артикул -> наименование.
// Строки, где товар выбран вручную, не трогаются.
Процедура НайтиТовары(ДокументыРазбора, СтрокиРазбора, Поставщики)

	ПоставщикФайла = Новый Соответствие;
	Для Каждого Документ Из ДокументыРазбора Цикл
		Если ИННКорректен(Документ.ПродавецИНН) Тогда
			ПоставщикФайла.Вставить(Документ.ИдФайла, Поставщики.Получить(КлючПоставщика(Документ.ПродавецИНН, Документ.ПродавецКПП)));
		КонецЕсли;
	КонецЦикла;
	Искать = Новый Массив;
	Для Каждого Строка Из СтрокиРазбора Цикл
		Если Строка.КакНайдена = "вручную" И ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Строка.Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
		Строка.КакНайдена = "";
		Строка.Пояснение = "";
		Искать.Добавить(Строка);
	КонецЦикла;
	Если Искать.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// 1. Соответствие «код поставщика -> товар», которое запоминается при создании документов.
	Пары = Новый ТаблицаЗначений;
	Пары.Колонки.Добавить("Поставщик", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	Пары.Колонки.Добавить("Ключ", ОписаниеСтроки(150));
	Для Каждого Строка Из Искать Цикл
		Поставщик = ПоставщикФайла.Получить(Строка.ИдФайла);
		Если ЗначениеЗаполнено(Поставщик) Тогда
			Пара = Пары.Добавить();
			Пара.Поставщик = Поставщик;
			Пара.Ключ = КлючСоответствия(Строка);
		КонецЕсли;
	КонецЦикла;
	Если Пары.Количество() > 0 Тогда
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Пары.Поставщик КАК Поставщик,
		|	Пары.Ключ КАК Ключ
		|ПОМЕСТИТЬ Пары
		|ИЗ
		|	&Пары КАК Пары
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НП.Владелец КАК Поставщик,
		|	НП.Идентификатор КАК Ключ,
		|	НП.Номенклатура КАК Номенклатура
		|ИЗ
		|	Справочник.НоменклатураПоставщиков КАК НП
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Пары КАК Пары
		|		ПО НП.Владелец = Пары.Поставщик
		|			И НП.Идентификатор = Пары.Ключ
		|ГДЕ
		|	НЕ НП.ПометкаУдаления
		|	И НЕ НП.Номенклатура.ПометкаУдаления");
		Запрос.УстановитьПараметр("Пары", Пары);
		Соответствия = Новый Соответствие;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Соответствия.Вставить(XMLСтрока(Выборка.Поставщик) + "|" + Выборка.Ключ, Выборка.Номенклатура);
		КонецЦикла;
		Для Каждого Строка Из Искать Цикл
			Поставщик = ПоставщикФайла.Получить(Строка.ИдФайла);
			Если ЗначениеЗаполнено(Поставщик) Тогда
				Найден = Соответствия.Получить(XMLСтрока(Поставщик) + "|" + КлючСоответствия(Строка));
				УстановитьТовар(Строка, Найден, "соответствие");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// 2. Штрихкод из документа.
	Штрихкоды = Новый Массив;
	Для Каждого Строка Из Искать Цикл
		Если Не ЗначениеЗаполнено(Строка.Номенклатура) И Не ПустаяСтрока(Строка.Штрихкод) Тогда
			Штрихкоды.Добавить(Строка.Штрихкод);
		КонецЕсли;
	КонецЦикла;
	Если Штрихкоды.Количество() > 0 Тогда
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Штрихкоды.Штрихкод КАК Штрихкод,
		|	Штрихкоды.Номенклатура КАК Номенклатура
		|ИЗ
		|	РегистрСведений.ШтрихкодыНоменклатуры КАК Штрихкоды
		|ГДЕ
		|	Штрихкоды.Штрихкод В (&Штрихкоды)
		|	И НЕ Штрихкоды.Номенклатура.ПометкаУдаления");
		Запрос.УстановитьПараметр("Штрихкоды", Штрихкоды);
		ПоШтрихкоду = Новый Соответствие;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ПоШтрихкоду.Вставить(Выборка.Штрихкод, Выборка.Номенклатура);
		КонецЦикла;
		Для Каждого Строка Из Искать Цикл
			Если Не ЗначениеЗаполнено(Строка.Номенклатура) И Не ПустаяСтрока(Строка.Штрихкод) Тогда
				УстановитьТовар(Строка, ПоШтрихкоду.Получить(Строка.Штрихкод), "штрихкод");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// 3. Код поставщика совпадает с артикулом в 1С. Артикул должен быть у одного товара.
	Артикулы = Новый Массив;
	Для Каждого Строка Из Искать Цикл
		Если Не ЗначениеЗаполнено(Строка.Номенклатура) И Не ПустаяСтрока(Строка.КодПоставщика) Тогда
			Артикулы.Добавить(Строка.КодПоставщика);
		КонецЕсли;
	КонецЦикла;
	Если Артикулы.Количество() > 0 Тогда
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Номенклатура.Артикул КАК Артикул,
		|	МАКСИМУМ(Номенклатура.Ссылка) КАК Ссылка,
		|	КОЛИЧЕСТВО(Номенклатура.Ссылка) КАК Количество
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Артикул В (&Артикулы)
		|	И НЕ Номенклатура.ПометкаУдаления
		|	И НЕ Номенклатура.ЭтоГруппа
		|
		|СГРУППИРОВАТЬ ПО
		|	Номенклатура.Артикул");
		Запрос.УстановитьПараметр("Артикулы", Артикулы);
		ПоАртикулу = Новый Соответствие;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.Количество = 1 Тогда
				ПоАртикулу.Вставить(ВРег(СокрЛП(Выборка.Артикул)), Выборка.Ссылка);
			КонецЕсли;
		КонецЦикла;
		Для Каждого Строка Из Искать Цикл
			Если Не ЗначениеЗаполнено(Строка.Номенклатура) И Не ПустаяСтрока(Строка.КодПоставщика) Тогда
				УстановитьТовар(Строка, ПоАртикулу.Получить(ВРег(Строка.КодПоставщика)), "артикул");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// 4. Наименование без учёта регистра, кавычек и лишних пробелов. Имя должно быть у одного товара.
	Остались = 0;
	Для Каждого Строка Из Искать Цикл
		Если Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			Остались = Остались + 1;
		КонецЕсли;
	КонецЦикла;
	Если Остались > 0 Тогда
		ПоИмени = Новый Соответствие;
		Повторы = Новый Соответствие;
		ЗапросИмен = Новый Запрос(
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	НЕ Номенклатура.ПометкаУдаления
		|	И НЕ Номенклатура.ЭтоГруппа");
		Выборка = ЗапросИмен.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Ключ = НормализоватьТекст(Выборка.Наименование);
			Если ПоИмени.Получить(Ключ) <> Неопределено Тогда
				Повторы.Вставить(Ключ, Истина);
			КонецЕсли;
			ПоИмени.Вставить(Ключ, Выборка.Ссылка);
		КонецЦикла;
		Для Каждого Строка Из Искать Цикл
			Ключ = НормализоватьТекст(Строка.Наименование);
			Если Не ЗначениеЗаполнено(Строка.Номенклатура) И Повторы.Получить(Ключ) = Неопределено Тогда
				УстановитьТовар(Строка, ПоИмени.Получить(Ключ), "наименование");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьТовар(Строка, Номенклатура, Как)

	Если Номенклатура <> Неопределено И ЗначениеЗаполнено(Номенклатура) И Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
		Строка.Номенклатура = Номенклатура;
		Строка.КакНайдена = Как;
	КонецЕсли;

КонецПроцедуры

// Ключ соответствия поставщика: код товара у поставщика, а если кода нет, наименование.
Функция КлючСоответствия(Строка)
	Возврат Лев(НормализоватьТекст(?(ПустаяСтрока(Строка.КодПоставщика), Строка.Наименование, Строка.КодПоставщика)), 150);
КонецФункции

// Запоминает «код поставщика -> товар» для строк, которые нашлись не по соответствию.
Процедура ЗапомнитьСоответствия(Поставщик, СтрокиДокумента)

	Пары = Новый ТаблицаЗначений;
	Пары.Колонки.Добавить("Поставщик", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	Пары.Колонки.Добавить("Ключ", ОписаниеСтроки(150));
	Для Каждого Строка Из СтрокиДокумента Цикл
		Пара = Пары.Добавить();
		Пара.Поставщик = Поставщик;
		Пара.Ключ = КлючСоответствия(Строка);
	КонецЦикла;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	НП.Идентификатор КАК Ключ
	|ИЗ
	|	Справочник.НоменклатураПоставщиков КАК НП
	|ГДЕ
	|	НП.Владелец = &Поставщик
	|	И НП.Идентификатор В (&Ключи)
	|	И НЕ НП.ПометкаУдаления");
	Запрос.УстановитьПараметр("Поставщик", Поставщик);
	Запрос.УстановитьПараметр("Ключи", Пары.ВыгрузитьКолонку("Ключ"));
	Есть = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Есть.Вставить(Выборка.Ключ, Истина);
	КонецЦикла;
	Для Каждого Строка Из СтрокиДокумента Цикл
		Ключ = КлючСоответствия(Строка);
		Если Есть.Получить(Ключ) <> Неопределено Или Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Элемент = Справочники.НоменклатураПоставщиков.СоздатьЭлемент();
		Элемент.Владелец = Поставщик;
		Элемент.Наименование = Лев(Строка.Наименование, 100);
		Элемент.Идентификатор = Ключ;
		Элемент.Артикул = Лев(Строка.КодПоставщика, 25);
		Элемент.Номенклатура = Строка.Номенклатура;
		Элемент.Записать();
		Есть.Вставить(Ключ, Истина);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СозданиеДокументов

// Приходная накладная: заполнение как у УНФ по организации и контрагенту, затем склад, входящий номер
// и строки с суммами из документа поставщика. Итог документа в 1С обязан совпасть с итогом поставщика.
Функция НоваяПриходнаяНакладная(Документ, СтрокиДокумента, Настройки)

	Накладная = Документы.ПриходнаяНакладная.СоздатьДокумент();
	Накладная.Заполнить(Новый Структура("Организация, Контрагент", Настройки.Организация, Документ.Поставщик));
	Накладная.Дата = ТекущаяДатаСеанса();
	Накладная.Организация = Настройки.Организация;
	Накладная.Контрагент = Документ.Поставщик;
	Накладная.СтруктурнаяЕдиница = Настройки.Склад;
	Накладная.НомерВходящегоДокумента = Документ.Номер;
	Накладная.ДатаВходящегоДокумента = Документ.Дата;
	Накладная.СуммаВключаетНДС = Документ.ЦеныСНДС;
	Комментарий = Новый Массив;
	Комментарий.Добавить(СтрШаблон(НСтр("ru = 'Загружено из PDF «%1»: %2 № %3 от %4'"), Документ.Файл, Документ.Тип, Документ.Номер,
		Формат(Документ.Дата, "ДЛФ=D")));
	Если ЗначениеЗаполнено(Документ.Пояснение) И Документ.Статус = "Проверить" Тогда
		Комментарий.Добавить(НСтр("ru = 'Загружено с расхождениями, подтверждено вручную: '") + Документ.Пояснение);
	КонецЕсли;
	Накладная.Комментарий = СтрСоединить(Комментарий, Символы.ПС);

	Единицы = ЕдиницыТоваров(СтрокиДокумента);
	Для Каждого Строка Из СтрокиДокумента Цикл
		Товар = Накладная.Запасы.Добавить();
		Товар.Номенклатура = Строка.Номенклатура;
		Товар.ЕдиницаИзмерения = Единицы.Получить(Строка.Номенклатура);
		Товар.Количество = Строка.Количество;
		Товар.Цена = Строка.Цена;
		Товар.Сумма = Строка.Сумма;
		Товар.СтавкаНДС = СтавкаНДС(Строка.СтавкаНДС);
		Товар.СуммаНДС = Строка.СуммаНДС;
		Товар.Всего = Строка.Всего;
		Товар.Содержание = Лев(Строка.Наименование, 250);
	КонецЦикла;

	Если Настройки.ПроводитьДокументы Тогда
		Если Не Накладная.ПроверитьЗаполнение() Тогда
			Тексты = Новый Массив;
			Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
				Тексты.Добавить(Сообщение.Текст);
			КонецЦикла;
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Документ не прошёл проверку заполнения: %1'"), СтрСоединить(Тексты, "; "));
		КонецЕсли;
		Накладная.Записать(РежимЗаписиДокумента.Проведение);
	Иначе
		Накладная.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	Если Макс(Накладная.СуммаДокумента - Документ.Всего, Документ.Всего - Накладная.СуммаДокумента) > 0.005 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Сумма документа в 1С %1 не совпала с итогом поставщика %2'"),
			ФорматСуммы(Накладная.СуммаДокумента), ФорматСуммы(Документ.Всего));
	КонецЕсли;
	Возврат Накладная.Ссылка;

КонецФункции

Функция ЕдиницыТоваров(СтрокиДокумента)

	Товары = Новый Массив;
	Для Каждого Строка Из СтрокиДокумента Цикл
		Товары.Добавить(Строка.Номенклатура);
	КонецЦикла;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В (&Товары)");
	Запрос.УстановитьПараметр("Товары", Товары);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Выборка.ЕдиницаИзмерения);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Контрагент для поставщика, которого ещё нет в 1С. Договор с поставщиком УНФ создаёт сама.
Функция НовыйПоставщик(Документ)

	Если Не ИННКорректен(Документ.ПродавецИНН) Тогда
		ВызватьИсключение НСтр("ru = 'Нельзя создать поставщика с неверным ИНН'");
	КонецЕсли;
	Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
	Контрагент.Заполнить(Неопределено);
	Контрагент.Наименование = КраткоеНаименование(Документ.ПродавецНаименование);
	Контрагент.НаименованиеПолное = Документ.ПродавецНаименование;
	Контрагент.ИНН = Документ.ПродавецИНН;
	Контрагент.КПП = Документ.ПродавецКПП;
	Контрагент.Поставщик = Истина;
	Контрагент.Записать();
	Возврат Контрагент.Ссылка;

КонецФункции

// «ООО "ХозОптТорг"» -> «ХозОптТорг».
Функция КраткоеНаименование(Знач Наименование)

	Наименование = СокрЛП(Наименование);
	Для Каждого Форма Из СтрРазделить("ООО ,АО ,ПАО ,ЗАО ,ОАО ,ИП ", ",") Цикл
		Если СтрНачинаетсяС(ВРег(Наименование), Форма) Тогда
			Наименование = СокрЛП(Сред(Наименование, СтрДлина(Форма) + 1));
		КонецЕсли;
	КонецЦикла;
	Для Каждого Кавычка Из СтрРазделить("""|«|»", "|") Цикл
		Наименование = СтрЗаменить(Наименование, Кавычка, "");
	КонецЦикла;
	Возврат СокрЛП(Наименование);

КонецФункции

Процедура ПриложитьФайл(Ссылка, ИмяФайла, Данные)

	ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
	ПараметрыФайла.ВладелецФайлов = Ссылка;
	ПараметрыФайла.ИмяБезРасширения = ?(СтрЗаканчиваетсяНа(НРег(ИмяФайла), ".pdf"), Лев(ИмяФайла, СтрДлина(ИмяФайла) - 4), ИмяФайла);
	ПараметрыФайла.РасширениеБезТочки = "pdf";
	Адрес = ПоместитьВоВременноеХранилище(Данные, Новый УникальныйИдентификатор);
	РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, Адрес, , НСтр("ru = 'Документ поставщика, по которому создана накладная'"));

