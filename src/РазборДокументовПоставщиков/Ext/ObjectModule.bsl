Функция ДанныеФайла(Файлы, ИдФайла)

	Если ТипЗнч(Файлы) = Тип("Массив") И ИдФайла >= 1 И ИдФайла <= Файлы.Количество() Тогда
		Файл = Файлы[ИдФайла - 1];
		Если ТипЗнч(Файл) = Тип("Структура") И Файл.Свойство("Данные") Тогда
			Возврат Файл.Данные;
		КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;

