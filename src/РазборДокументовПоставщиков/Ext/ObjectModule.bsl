Функция ПроверитьНастройки(Настройки, ДляСоздания)

	Ошибки = Новый Массив;
	Если Не ДляСоздания И ПустаяСтрока(Настройки.КлючAPI) Тогда
		Ошибки.Добавить(НСтр("ru = 'Не указан ключ API Claude.'"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Настройки.Организация) Тогда
		Ошибки.Добавить(НСтр("ru = 'Не указана организация: по ней проверяется покупатель в документе.'"));
	КонецЕсли;
	Если ДляСоздания И Не ЗначениеЗаполнено(Настройки.Склад) Тогда
		Ошибки.Добавить(НСтр("ru = 'Не указан склад для приходных накладных.'"));
	КонецЕсли;
	Если Не ДляСоздания И (Настройки.МаксТокенов < 1024 Или Настройки.МаксТокенов > 64000) Тогда
		Ошибки.Добавить(НСтр("ru = 'Макс. токенов должно быть от 1 024 до 64 000.'"));
	КонецЕсли;
	Возврат Ошибки;

