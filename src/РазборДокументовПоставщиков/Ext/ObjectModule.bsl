// Входящие документы поставщиков из PDF в «Приходные накладные» 1С:УНФ 3.0.
// PDF (УПД, счёт-фактура, ТОРГ-12, счёт на оплату) отправляется в Claude API, модель возвращает
// реквизиты и строки по JSON-схеме. Дальше всё проверяет 1С: контрольную сумму ИНН, покупателя,
// арифметику строк и итогов, ставки НДС, дубли; товары сопоставляются по соответствию поставщика,
// штрихкоду, артикулу и наименованию. Документ создаётся черновиком с приложенным PDF.
//
// Запросы идут по очереди, на сервере без ожидания: если API просит подождать (429, 529, 5xx),
// шаг возвращает ЖдатьМс, а ждёт вызывающий код (форма через обработчик ожидания).
// Формат запроса сверен с документацией Claude API (версия API 2026-10-21).

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Сведения для подключения через «Дополнительные отчеты и обработки» (БСП).
Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("3.1.10.1");
	ПараметрыРегистрации.Вид = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Версия = "1.0";
	ПараметрыРегистрации.БезопасныйРежим = Ложь;
	ПараметрыРегистрации.Информация = НСтр("ru = 'Документы поставщиков из PDF: разбор через Claude API, проверки и черновики приходных накладных.'");

	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = НСтр("ru = 'Документы поставщиков из PDF'");
	Команда.Идентификатор = "ОткрытьФорму";
	Команда.Использование = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	Команда.ПоказыватьОповещение = Ложь;

	Возврат ПараметрыРегистрации;

КонецФункции

// Настройки со значениями по умолчанию.
Функция НовыеНастройки() Экспорт

	Настройки = Новый Структура;
	Настройки.Вставить("КлючAPI", "");
	Настройки.Вставить("АдресAPI", "https://api.anthropic.com");
	Настройки.Вставить("Модель", "claude-opus-5-5");
	Настройки.Вставить("Усилие", "high");
	Настройки.Вставить("РезервнаяМодель", Истина);
	Настройки.Вставить("МаксТокенов", 16000);
	Настройки.Вставить("ТаймаутСекунд", 300);
	Настройки.Вставить("МаксПопыток", 5);
	Настройки.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	Настройки.Вставить("Склад", Справочники.СтруктурныеЕдиницы.ПустаяСсылка());
	Настройки.Вставить("СоздаватьПоставщиков", Ложь);
	Настройки.Вставить("ПроводитьДокументы", Ложь);
	Настройки.Вставить("ПрикладыватьФайл", Истина);
	Возврат Настройки;

КонецФункции

// Сохранённые настройки текущего пользователя; ключ API берётся из безопасного хранилища.
Функция ЗагрузитьНастройки() Экспорт

	Настройки = НовыеНастройки();
	Сохраненные = ХранилищеОбщихНастроек.Загрузить(КлючНастроек(), "Настройки");
	Если ТипЗнч(Сохраненные) = Тип("Структура") Тогда
		// Только известные ключи: настройки от старой версии обработки не должны ломать загрузку.
		Для Каждого КлючИЗначение Из Сохраненные Цикл
			Если КлючИЗначение.Ключ <> "КлючAPI" И Настройки.Свойство(КлючИЗначение.Ключ) Тогда
				Настройки.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Ключ = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(КлючНастроек(), "КлючAPI");
	УстановитьПривилегированныйРежим(Ложь);
	Если ТипЗнч(Ключ) = Тип("Строка") Тогда
		Настройки.КлючAPI = Ключ;
	КонецЕсли;
	Возврат Настройки;

КонецФункции

// Ключ API кладётся в безопасное хранилище БСП, в обычные настройки он не попадает.
Процедура СохранитьНастройки(Настройки) Экспорт

	Копия = Новый Структура;
	Для Каждого КлючИЗначение Из Настройки Цикл
		Если КлючИЗначение.Ключ <> "КлючAPI" Тогда
			Копия.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	ХранилищеОбщихНастроек.Сохранить(КлючНастроек(), "Настройки", Копия);
	УстановитьПривилегированныйРежим(Истина);
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(КлючНастроек(), СокрЛП(Настройки.КлючAPI), "КлючAPI");
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Начинает разбор. Файлы: Массив из Структура(Имя, Данные), Данные - ДвоичныеДанные PDF.
// Дальше вызывайте ВыполнитьШаг, пока Состояние.Готово = Ложь; при ЖдатьМс > 0 подождите.
Функция НачатьРазбор(Файлы, Настройки) Экспорт

	Состояние = Новый Структура;
	Состояние.Вставить("Настройки", Настройки);
	Состояние.Вставить("Очередь", НоваяОчередь());
	Состояние.Вставить("Готово", Ложь);
	Состояние.Вставить("ЖдатьМс", 0);
	Состояние.Вставить("Ошибка", "");
	Состояние.Вставить("Запросов", 0);
	Состояние.Вставить("Повторов", 0);
	Состояние.Вставить("ПаузМс", 0);
	Состояние.Вставить("Начало", ТекущаяУниверсальнаяДатаВМиллисекундах());
	Состояние.Вставить("ДлительностьМс", 0);
	Состояние.Вставить("Сообщения", Новый Массив);
	Состояние.Вставить("Документы", НоваяТаблицаДокументов());
	Состояние.Вставить("Строки", НоваяТаблицаСтрок());

	Ошибки = ПроверитьНастройки(Настройки, Ложь);
	Если Ошибки.Количество() > 0 Тогда
		Остановить(Состояние, СтрСоединить(Ошибки, Символы.ПС));
		Возврат Состояние;
	КонецЕсли;
	Ид = 0;
	Для Каждого Файл Из Файлы Цикл
		Ид = Ид + 1;
		Элемент = Состояние.Очередь.Добавить();
		Элемент.ИдФайла = Ид;
		Элемент.Имя = Файл.Имя;
		Элемент.Данные = Файл.Данные;
	КонецЦикла;
	Если Ид = 0 Тогда
		Остановить(Состояние, НСтр("ru = 'Не выбраны файлы PDF.'"));
	КонецЕсли;
	Возврат Состояние;

КонецФункции

// Отправляет документы из очереди, пока не кончится очередь, не понадобится пауза
// или не выйдет время шага. Когда очередь пуста, проверяет разобранные документы.
Функция ВыполнитьШаг(Состояние, БюджетМс = 20000) Экспорт

	Старт = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Состояние.ЖдатьМс = 0;
	Пока Не Состояние.Готово Цикл

		Если Состояние.Очередь.Количество() = 0 Тогда
			ПроверитьДокументы(Состояние.Документы, Состояние.Строки, Состояние.Настройки);
			Состояние.Готово = Истина;
			Состояние.ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - Состояние.Начало;
			ЗаписьЖурналаРегистрации(СобытиеЖурнала(), УровеньЖурналаРегистрации.Информация, , ,
				СтрШаблон("%1 Запросов %2, повторов %3, пауз %4 мс, всего %5 мс.", ИтогРазбора(Состояние.Документы),
					Состояние.Запросов, Состояние.Повторов, Состояние.ПаузМс, Состояние.ДлительностьМс));
			Прервать;
		КонецЕсли;

		Элемент = Состояние.Очередь[0];
		Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Если Элемент.НеРаньше > Сейчас Тогда
			Состояние.ЖдатьМс = Элемент.НеРаньше - Сейчас;
			Прервать;
		КонецЕсли;

		Ответ = ВыполнитьЗапрос(Состояние.Настройки, ТелоЗапроса(Элемент.Данные, Состояние.Настройки));
		Состояние.Запросов = Состояние.Запросов + 1;
		Решение = ОценитьОтвет(Ответ, Элемент.Попыток);

		Если Решение.Действие = "Повторить" Тогда
			Элемент.Попыток = Элемент.Попыток + 1;
			Если Элемент.Попыток >= Состояние.Настройки.МаксПопыток Тогда
				ДобавитьОшибкуФайла(Состояние, Элемент, СтрШаблон(НСтр("ru = 'API не ответил после %1 попыток. Последняя причина: %2'"),
					Элемент.Попыток, Решение.Текст));
				Состояние.Очередь.Удалить(Элемент);
				Продолжить;
			КонецЕсли;
			Элемент.НеРаньше = ТекущаяУниверсальнаяДатаВМиллисекундах() + Решение.ПаузаМс;
			Состояние.Повторов = Состояние.Повторов + 1;
			Состояние.ПаузМс = Состояние.ПаузМс + Решение.ПаузаМс;
			Состояние.ЖдатьМс = Решение.ПаузаМс;
			ДобавитьСообщение(Состояние, Элемент.Имя + ": " + Решение.Текст);
			Прервать;
		ИначеЕсли Решение.Действие = "Остановить" Тогда
			Остановить(Состояние, Решение.Текст);
			Прервать;
		ИначеЕсли Решение.Действие = "ОшибкаФайла" Тогда
			ДобавитьОшибкуФайла(Состояние, Элемент, Решение.Текст);
		Иначе
			Попытка
				РазобратьОтвет(Состояние, Элемент, Ответ);
			Исключение
				ДобавитьОшибкуФайла(Состояние, Элемент, ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЕсли;
		Состояние.Очередь.Удалить(Элемент);

		Если ТекущаяУниверсальнаяДатаВМиллисекундах() - Старт > БюджетМс Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Состояние;

КонецФункции

// Проверяет разобранные документы и сопоставляет товары. Можно вызывать повторно,
// например после того как в строке вручную выбрали товар.
Процедура ПроверитьДокументы(ДокументыРазбора, СтрокиРазбора, Настройки) Экспорт

	ИННОрганизации = ?(ЗначениеЗаполнено(Настройки.Организация), СокрЛП(Настройки.Организация.ИНН), "");
	Поставщики = ПоставщикиПоИНН(ДокументыРазбора);
	Загруженные = ЗагруженныеДокументы(ДокументыРазбора, Поставщики);
	НайтиТовары(ДокументыРазбора, СтрокиРазбора, Поставщики);

	Для Каждого Документ Из ДокументыРазбора Цикл
		Если Документ.Статус = "Ошибка разбора" Или Документ.Статус = "Создан" Тогда
			Продолжить;
		КонецЕсли;
		СтрокиДокумента = СтрокиРазбора.НайтиСтроки(Новый Структура("ИдФайла", Документ.ИдФайла));
		Проблемы = Новый Массив;
		Документ.Документ1С = Документы.ПриходнаяНакладная.ПустаяСсылка();
		Статус = "Готов";

		// Покупатель: документ мог прийти не тому адресату.
		Если ЗначениеЗаполнено(ИННОрганизации) И СокрЛП(Документ.ПокупательИНН) <> ИННОрганизации Тогда
			Статус = ХудшийСтатус(Статус, "Не наш документ");
			Проблемы.Добавить(СтрШаблон(НСтр("ru = 'Покупатель в документе %1 (ИНН %2), а организация в настройках %3 (ИНН %4)'"),
				Документ.ПокупательНаименование, Документ.ПокупательИНН, Настройки.Организация, ИННОрганизации));
		КонецЕсли;

		// ИНН продавца проверяется контрольной суммой: так ловится неверно прочитанная цифра.
		Если Не ИННКорректен(Документ.ПродавецИНН) Тогда
			Статус = ХудшийСтатус(Статус, "Проверить ИНН");
			Проблемы.Добавить(СтрШаблон(НСтр("ru = 'ИНН продавца %1 не проходит проверку контрольной суммы: вероятно, цифра прочитана неверно'"),
				Документ.ПродавецИНН));
			Документ.Поставщик = Справочники.Контрагенты.ПустаяСсылка();
		Иначе
			// Неопределено в колонку ссылочного типа записывается пустой ссылкой, поэтому проверяется переменная.
			Найден = Поставщики.Получить(КлючПоставщика(Документ.ПродавецИНН, Документ.ПродавецКПП));
			Документ.Поставщик = ?(Найден = Неопределено, Справочники.Контрагенты.ПустаяСсылка(), Найден);
			Если Найден = Неопределено Тогда
				Статус = ХудшийСтатус(Статус, "Новый поставщик");
				Проблемы.Добавить(СтрШаблон(НСтр("ru = 'Поставщика с ИНН %1 нет в 1С%2'"), Документ.ПродавецИНН,
					?(Настройки.СоздаватьПоставщиков, НСтр("ru = ', он будет создан вместе с документом'"),
						НСтр("ru = ': заведите контрагента или включите «Создавать поставщиков»'"))));
			Иначе
				Был = Загруженные.Получить(КлючДокумента(Документ.Поставщик, Документ.Номер));
				Если Был <> Неопределено Тогда
					Статус = ХудшийСтатус(Статус, "Уже загружен");
					Документ.Документ1С = Был;
					Проблемы.Добавить(СтрШаблон(НСтр("ru = 'Уже загружен: %1'"), Был));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		// Арифметика строк и итогов. Поставщики ошибаются, модель тоже может прочитать цифру неверно.
		СуммаСтрок = 0;
		НДССтрок = 0;
		БезНДССтрок = 0;
		Ненайденных = 0;
		Для Каждого Строка Из СтрокиДокумента Цикл
			Ошибка = ОшибкаАрифметикиСтроки(Строка, Документ.ЦеныСНДС);
			Если Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
				Ненайденных = Ненайденных + 1;
			КонецЕсли;
			Если ЗначениеЗаполнено(Ошибка) Тогда
				Строка.Статус = "Ошибка в строке";
				Строка.Пояснение = Ошибка;
				Статус = ХудшийСтатус(Статус, "Проверить");
				Проблемы.Добавить(СтрШаблон(НСтр("ru = 'строка %1: %2'"), Строка.НомерСтроки, Ошибка));
			ИначеЕсли СтавкаНДС(Строка.СтавкаНДС) = Неопределено Тогда
				Строка.Статус = "Ошибка в строке";
				Строка.Пояснение = СтрШаблон(НСтр("ru = 'ставки НДС «%1» нет в 1С'"), Строка.СтавкаНДС);
				Статус = ХудшийСтатус(Статус, "Проверить");
				Проблемы.Добавить(СтрШаблон(НСтр("ru = 'строка %1: %2'"), Строка.НомерСтроки, Строка.Пояснение));
			ИначеЕсли ЗначениеЗаполнено(Строка.Номенклатура) Тогда
				Строка.Статус = "Найден";
			Иначе
				Строка.Статус = "Нужно сопоставить";
				Строка.Пояснение = НСтр("ru = 'Выберите товар 1С: соответствие запомнится для этого поставщика'");
			КонецЕсли;
			СуммаСтрок = СуммаСтрок + Строка.Всего;
			НДССтрок = НДССтрок + Строка.СуммаНДС;
			БезНДССтрок = БезНДССтрок + ?(Документ.ЦеныСНДС, Строка.Сумма - Строка.СуммаНДС, Строка.Сумма);
		КонецЦикла;
		Если Макс(СуммаСтрок - Документ.Всего, Документ.Всего - СуммаСтрок) > 0.005 Тогда
			Статус = ХудшийСтатус(Статус, "Проверить");
			Проблемы.Добавить(СтрШаблон(НСтр("ru = 'сумма строк %1 не равна итогу документа %2'"), ФорматСуммы(СуммаСтрок), ФорматСуммы(Документ.Всего)));
		КонецЕсли;
		Если Макс(НДССтрок - Документ.СуммаНДС, Документ.СуммаНДС - НДССтрок) > 0.005 Тогда
			Статус = ХудшийСтатус(Статус, "Проверить");
			Проблемы.Добавить(СтрШаблон(НСтр("ru = 'НДС по строкам %1 не равен НДС в итоге %2'"), ФорматСуммы(НДССтрок), ФорматСуммы(Документ.СуммаНДС)));
		КонецЕсли;
		Если СтрокиДокумента.Количество() = 0 Тогда
			Статус = ХудшийСтатус(Статус, "Проверить");
			Проблемы.Добавить(НСтр("ru = 'в документе не найдено ни одной строки товаров'"));
		КонецЕсли;
		Если Ненайденных > 0 Тогда
			Статус = ХудшийСтатус(Статус, "Нужно сопоставить");
			Проблемы.Добавить(СтрШаблон(НСтр("ru = 'не найдено товаров: %1'"), Ненайденных));
		КонецЕсли;
		Если ЗначениеЗаполнено(Документ.Нечитаемо) Тогда
			Статус = ХудшийСтатус(Статус, "Проверить");
			Проблемы.Добавить(НСтр("ru = 'модель не уверена: '") + Документ.Нечитаемо);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Документ.Дата) Или ПустаяСтрока(Документ.Номер) Тогда
			Статус = ХудшийСтатус(Статус, "Проверить");
			Проблемы.Добавить(НСтр("ru = 'не прочитаны номер или дата документа'"));
		КонецЕсли;

		Документ.Статус = Статус;
		Документ.Пояснение = СтрСоединить(Проблемы, "; ");
		// Сам применяется только документ без вопросов. «Проверить» человек подтверждает отметкой.
		Документ.Применить = (Статус = "Готов") Или (Статус = "Новый поставщик" И Настройки.СоздаватьПоставщиков);
	КонецЦикла;

КонецПроцедуры

// Создаёт приходные накладные по отмеченным документам. Каждый документ в своей транзакции,
// перед записью ещё раз проверяется, что он не загружен. Файлы: как в НачатьРазбор, по порядку ИдФайла.
Функция СоздатьДокументы(ДокументыРазбора, СтрокиРазбора, Файлы, Настройки) Экспорт

	Итог = Новый Структура("Создано, Пропущено, Ошибок, ВремяМс", 0, 0, 0, 0);
	Старт = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Ошибки = ПроверитьНастройки(Настройки, Истина);
	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;
	Запрещенные = СтрРазделить("Ошибка разбора,Не наш документ,Проверить ИНН,Уже загружен,Создан", ",");

	Для Каждого Документ Из ДокументыРазбора Цикл
		Если Не Документ.Применить Или Запрещенные.Найти(Документ.Статус) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокиДокумента = СтрокиРазбора.НайтиСтроки(Новый Структура("ИдФайла", Документ.ИдФайла));
		Пропуски = Новый Массив;
		Для Каждого Строка Из СтрокиДокумента Цикл
			Если Не ЗначениеЗаполнено(Строка.Номенклатура) Тогда
				Пропуски.Добавить(Формат(Строка.НомерСтроки, "ЧГ=0"));
			КонецЕсли;
		КонецЦикла;
		Если Пропуски.Количество() > 0 Тогда
			Документ.Пояснение = СтрШаблон(НСтр("ru = 'Не выбран товар 1С в строках %1'"), СтрСоединить(Пропуски, ", "));
			Итог.Пропущено = Итог.Пропущено + 1;
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Документ.Поставщик) И Не Настройки.СоздаватьПоставщиков Тогда
			Итог.Пропущено = Итог.Пропущено + 1;
			Продолжить;
		КонецЕсли;

		НачатьТранзакцию();
		Попытка
			Если Не ЗначениеЗаполнено(Документ.Поставщик) Тогда
				Документ.Поставщик = НовыйПоставщик(Документ);
			КонецЕсли;
			Был = ЗагруженныеДокументы(Документ, Неопределено).Получить(КлючДокумента(Документ.Поставщик, Документ.Номер));
			Если Был <> Неопределено Тогда
				ОтменитьТранзакцию();
				Документ.Статус = "Уже загружен";
				Документ.Документ1С = Был;
				Документ.Применить = Ложь;
				Итог.Пропущено = Итог.Пропущено + 1;
				Продолжить;
			КонецЕсли;
			Ссылка = НоваяПриходнаяНакладная(Документ, СтрокиДокумента, Настройки);
			ЗапомнитьСоответствия(Документ.Поставщик, СтрокиДокумента);
			Если Настройки.ПрикладыватьФайл Тогда
				Данные = ДанныеФайла(Файлы, Документ.ИдФайла);
				Если Данные <> Неопределено Тогда
					ПриложитьФайл(Ссылка, Документ.Файл, Данные);
				КонецЕсли;
			КонецЕсли;
			ЗафиксироватьТранзакцию();
			Документ.Статус = "Создан";
			Документ.Документ1С = Ссылка;
			Документ.Применить = Ложь;
			Документ.Пояснение = ?(Настройки.ПроводитьДокументы, НСтр("ru = 'создан и проведён'"), НСтр("ru = 'создан черновиком, проверьте и проведите'"));
			Итог.Создано = Итог.Создано + 1;
		Исключение
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			// Причину отказа УНФ сообщает сообщениями пользователю, в исключении только «Не удалось провести».
			Причины = Новый Массив;
			Причины.Добавить(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
				Причины.Добавить(Сообщение.Текст);
			КонецЦикла;
			Документ.Пояснение = СтрСоединить(Причины, " ");
			Итог.Ошибок = Итог.Ошибок + 1;
			ЗаписьЖурналаРегистрации(СобытиеЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
				СтрШаблон("%1: %2", Документ.Файл, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
	КонецЦикла;

	Итог.ВремяМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - Старт;
	ЗаписьЖурналаРегистрации(СобытиеЖурнала(), УровеньЖурналаРегистрации.Информация, , ,
		СтрШаблон("Приходные накладные из PDF: создано %1, пропущено %2, ошибок %3, за %4 с. Пользователь %5.",
			Итог.Создано, Итог.Пропущено, Итог.Ошибок, Формат(Итог.ВремяМс / 1000, "ЧДЦ=1; ЧН=0"), ИмяПользователя()));
	Возврат Итог;

КонецФункции

// Краткий итог по статусам документов: «Документов: 7, готов 1, проверить 2, ...».
Функция ИтогРазбора(ДокументыРазбора) Экспорт

	Счет = Новый Соответствие;
	Порядок = Новый Массив;
	Для Каждого Документ Из ДокументыРазбора Цикл
		Если Счет.Получить(Документ.Статус) = Неопределено Тогда
			Счет.Вставить(Документ.Статус, 0);
			Порядок.Добавить(Документ.Статус);
		КонецЕсли;
		Счет.Вставить(Документ.Статус, Счет.Получить(Документ.Статус) + 1);
	КонецЦикла;
	Части = Новый Массив;
	Части.Добавить(СтрШаблон(НСтр("ru = 'Документов: %1'"), ДокументыРазбора.Количество()));
	Для Каждого Статус Из Порядок Цикл
		Части.Добавить(НРег(Лев(Статус, 1)) + Сред(Статус, 2) + " " + Счет.Получить(Статус));
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ") + ".";

КонецФункции

Функция ПредставлениеПрогресса(Состояние) Экспорт

	Если Состояние.Готово Тогда
		Если ЗначениеЗаполнено(Состояние.Ошибка) Тогда
			Возврат Состояние.Ошибка;
		КонецЕсли;
		Возврат СтрШаблон(НСтр("ru = 'Готово за %1 с: запросов к API %2, повторов %3.'"),
			Формат(Состояние.ДлительностьМс / 1000, "ЧДЦ=1; ЧН=0"), Состояние.Запросов, Состояние.Повторов);
	КонецЕсли;
	Текст = СтрШаблон(НСтр("ru = 'Разбор: отправлено %1, в очереди %2'"), Состояние.Запросов, Состояние.Очередь.Количество());
	Если Состояние.ЖдатьМс > 0 Тогда
		Текст = Текст + СтрШаблон(НСтр("ru = ', пауза %1 с по просьбе API'"), Формат(Состояние.ЖдатьМс / 1000, "ЧДЦ=1; ЧН=0"));
	КонецЕсли;
	Возврат Текст;

КонецФункции

