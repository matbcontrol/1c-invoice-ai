Функция ТолькоЦифры(Знач Текст)

	Результат = "";
	Текст = Строка(Текст);
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЧислоИзСтроки(Знач Текст)

	Если ТипЗнч(Текст) = Тип("Число") Тогда
		Возврат Текст;
	КонецЕсли;
	Текст = СокрЛП(Строка(Текст));
	Если ПустаяСтрока(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789.", Сред(Текст, Позиция, 1)) = 0 Тогда
			Возврат 0;
		КонецЕсли;
	КонецЦикла;
	Попытка
		Возврат Число(Текст);
	Исключение
		Возврат 0;
	КонецПопытки;

