// Форма «Документы поставщиков из PDF».
// Разбор идёт шагами: сервер отправляет документы в Claude API, пока API не попросит паузу,
// клиент ждёт через обработчик ожидания и вызывает следующий шаг.
//
// Запуск по расписанию (папка, куда сохраняются вложения из почты):
//   1cv8.exe ENTERPRISE /F <база> /N <пользователь> /Execute РазборДокументовПоставщиков.epf /C "РазобратьПапку;C:\Обмен\PDF;C:\Обмен\отчет.txt"
//   создаются документы со статусом «Готов», остальные попадают в отчёт. Настройки и ключ берутся сохранённые.
// Открыть форму и сразу разобрать папку: /C "Открыть;C:\Обмен\PDF" (с «;Создать» ещё и создать готовые,
// с «;Создать;Показать» открыть первую созданную накладную). /C "Настройки" открывает страницу настроек.

&НаКлиенте
Перем ДействиеПослеРазбора; // "", "Создать" или "Пакет"
&НаКлиенте
Перем ПоказатьСозданный; // открыть первую созданную накладную

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Обработка = РеквизитФормыВЗначение("Объект");
	// Ошибка чтения настроек не должна останавливать открытие формы: при запуске по расписанию
	// окно с ошибкой некому закрыть.
	ОшибкаНастроек = "";
	Попытка
		НастройкиВФорму(Обработка.ЗагрузитьНастройки());
	Исключение
		ОшибкаНастроек = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		НастройкиВФорму(Обработка.НовыеНастройки());
	КонецПопытки;
	АдресСостояния = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	АдресФайлов = ПоместитьВоВременноеХранилище(Новый Массив, УникальныйИдентификатор);
	Элементы.Усилие.СписокВыбора.Добавить("low");
	Элементы.Усилие.СписокВыбора.Добавить("medium");
	Элементы.Усилие.СписокВыбора.Добавить("high");
	Элементы.Усилие.СписокВыбора.Добавить("xhigh");
	Элементы.Усилие.КнопкаВыпадающегоСписка = Истина;
	НастроитьОформление();
	ВыбраноФайлов = НСтр("ru = 'Файлы не выбраны'");
	Если ЗначениеЗаполнено(ОшибкаНастроек) Тогда
		Прогресс = НСтр("ru = 'Не удалось прочитать сохранённые настройки, заполните их заново: '") + ОшибкаНастроек;
	Иначе
		Прогресс = НСтр("ru = 'Выберите PDF поставщиков и нажмите «Разобрать».'");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ДействиеПослеРазбора = "";
	ПоказатьСозданный = Ложь;
	Если ПустаяСтрока(ПараметрЗапуска) Тогда
		Возврат;
	КонецЕсли;
	Части = СтрРазделить(ПараметрЗапуска, ";");
	Если Части[0] = "Настройки" Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНастройки;
		Возврат;
	ИначеЕсли Части[0] = "РазобратьПапку" И Части.Количество() > 1 Тогда
		РежимПакета = Истина;
		ПутьОтчета = ?(Части.Количество() > 2, Части[2], "");
		ДействиеПослеРазбора = "Пакет";
	ИначеЕсли Части[0] = "Открыть" И Части.Количество() > 1 Тогда
		ДействиеПослеРазбора = ?(Части.Количество() > 2 И Части[2] = "Создать", "Создать", "");
		ПоказатьСозданный = Части.Количество() > 3 И Части[3] = "Показать";
	Иначе
		Возврат;
	КонецЕсли;
	ФайлыИзПапкиНаСервере(Части[1]);
	// Работа начинается после открытия формы, чтобы окно успело показаться.
	ПодключитьОбработчикОжидания("НачатьРазбор", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура ДокументыПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.Документы.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		Элементы.Строки.ОтборСтрок = Новый ФиксированнаяСтруктура("ИдФайла", ТекущиеДанные.ИдФайла);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СтрокиНоменклатураПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Строки.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
		ТекущиеДанные.КакНайдена = "вручную";
		ТекущиеДанные.Статус = "Найден";
		ТекущиеДанные.Пояснение = НСтр("ru = 'выбран вручную, соответствие запомнится для поставщика'");
	Иначе
		ТекущиеДанные.КакНайдена = "";
		ТекущиеДанные.Статус = "Нужно сопоставить";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НастройкаПриИзменении(Элемент)
	// Настройки берутся из реквизитов формы при каждом разборе.
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьФайлы(Команда)

	ПараметрыЗагрузки = ФайловаяСистемаКлиент.ПараметрыЗагрузкиФайла();
	ПараметрыЗагрузки.ИдентификаторФормы = УникальныйИдентификатор;
	ПараметрыЗагрузки.Диалог.Заголовок = НСтр("ru = 'Документы поставщиков'");
	ПараметрыЗагрузки.Диалог.Фильтр = НСтр("ru = 'PDF (*.pdf)|*.pdf'");
	ФайловаяСистемаКлиент.ЗагрузитьФайлы(Новый ОписаниеОповещения("ПослеВыбораФайлов", ЭтотОбъект), ПараметрыЗагрузки);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайлов(ПомещенныеФайлы, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(ПомещенныеФайлы) <> Тип("Массив") Или ПомещенныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Описания = Новый Массив;
	Для Каждого Файл Из ПомещенныеФайлы Цикл
		Описания.Добавить(Новый Структура("Хранение, Имя", Файл.Хранение, Файл.Имя));
	КонецЦикла;
	ФайлыИзХранилищаНаСервере(Описания);

КонецПроцедуры

&НаКлиенте
Процедура Разобрать(Команда)
	НачатьРазбор();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументы(Команда)

	Если ИдетРазбор Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Дождитесь окончания разбора.'"));
		Возврат;
	КонецЕсли;
	СоздатьДокументыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСнова(Команда)
	ПроверитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройки(Команда)

	СохранитьНастройкиНаСервере();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Настройки сохранены'"), , НСтр("ru = 'Ключ API лежит в безопасном хранилище'"));

КонецПроцедуры

#КонецОбласти

#Область Разбор

&НаКлиенте
Процедура НачатьРазбор() Экспорт

	Если ИдетРазбор Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Разбор уже идёт.'"));
		Возврат;
	КонецЕсли;
	ИдетРазбор = Истина;
	ОбработатьШаг(НачатьРазборНаСервере());

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьШаг(Результат)

	Прогресс = Результат.Прогресс;
	Если Не Результат.Готово Тогда
		ПодключитьОбработчикОжидания("ПродолжитьРазбор", Макс(0.1, Результат.ЖдатьМс / 1000), Истина);
		Возврат;
	КонецЕсли;
	ИдетРазбор = Ложь;
	Если ДействиеПослеРазбора = "Пакет" Тогда
		Если Не ЗначениеЗаполнено(Результат.Ошибка) Тогда
			СоздатьДокументыНаСервере();
		КонецЕсли;
		ЗаписатьОтчетПакета(Результат.Ошибка);
		ЗавершитьРаботуСистемы(Ложь);
	ИначеЕсли ЗначениеЗаполнено(Результат.Ошибка) Тогда
		ПоказатьПредупреждение(, Результат.Ошибка);
	ИначеЕсли ДействиеПослеРазбора = "Создать" Тогда
		СоздатьДокументыНаСервере();
		Если ПоказатьСозданный Тогда
			Для Каждого Документ Из Документы Цикл
				Если ЗначениеЗаполнено(Документ.Документ1С) И Документ.Статус = "Создан" Тогда
					ПоказатьЗначение(, Документ.Документ1С);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	ДействиеПослеРазбора = "";

КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьРазбор() Экспорт
	ОбработатьШаг(ВыполнитьШагНаСервере());
КонецПроцедуры

&НаСервере
Функция НачатьРазборНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Состояние = Обработка.НачатьРазбор(ПолучитьИзВременногоХранилища(АдресФайлов), НастройкиИзФормы());
	Возврат ШагНаСервере(Обработка, Состояние);

КонецФункции

&НаСервере
Функция ВыполнитьШагНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Возврат ШагНаСервере(Обработка, ПолучитьИзВременногоХранилища(АдресСостояния));

КонецФункции

&НаСервере
Функция ШагНаСервере(Обработка, Состояние)

	Обработка.ВыполнитьШаг(Состояние, 15000);
	ПоместитьВоВременноеХранилище(Состояние, АдресСостояния);
	Если Состояние.Готово Тогда
		ЗначениеВРеквизитФормы(ПроблемыСверху(Состояние.Документы), "Документы");
		ЗначениеВРеквизитФормы(Состояние.Строки, "Строки");
		СводкаДокументов = Обработка.ИтогРазбора(Состояние.Документы)
			+ ?(Состояние.Сообщения.Количество() > 0, Символы.ПС + СтрСоединить(Состояние.Сообщения, Символы.ПС), "");
		ПоказатьСтрокиПервогоДокумента();
	КонецЕсли;
	Возврат Новый Структура("Готово, ЖдатьМс, Прогресс, Ошибка", Состояние.Готово, Состояние.ЖдатьМс,
		Обработка.ПредставлениеПрогресса(Состояние), Состояние.Ошибка);

КонецФункции

&НаСервере
Процедура ПроверитьНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Таблица = РеквизитФормыВЗначение("Документы");
	СтрокиТаблицы = РеквизитФормыВЗначение("Строки");
	Обработка.ПроверитьДокументы(Таблица, СтрокиТаблицы, НастройкиИзФормы());
	ЗначениеВРеквизитФормы(Таблица, "Документы");
	ЗначениеВРеквизитФормы(СтрокиТаблицы, "Строки");
	СводкаДокументов = Обработка.ИтогРазбора(Таблица);

КонецПроцедуры

&НаСервере
Процедура СоздатьДокументыНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Таблица = РеквизитФормыВЗначение("Документы");
	СтрокиТаблицы = РеквизитФормыВЗначение("Строки");
	Попытка
		Итог = Обработка.СоздатьДокументы(Таблица, СтрокиТаблицы, ПолучитьИзВременногоХранилища(АдресФайлов), НастройкиИзФормы());
	Исключение
		ОбщегоНазначения.СообщитьПользователю(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	ЗначениеВРеквизитФормы(Таблица, "Документы");
	ЗначениеВРеквизитФормы(СтрокиТаблицы, "Строки");
	СводкаДокументов = Обработка.ИтогРазбора(Таблица);
	Прогресс = СтрШаблон(НСтр("ru = 'Создано документов: %1, пропущено: %2, ошибок: %3.'"), Итог.Создано, Итог.Пропущено, Итог.Ошибок);

КонецПроцедуры

// Документы, с которыми надо что-то сделать, показываются первыми.
&НаСервереБезКонтекста
Функция ПроблемыСверху(Таблица)

	// Сначала то, что решает пользователь в форме (выбрать товар, подтвердить), потом то, что решается
	// с поставщиком (неверный ИНН, чужой документ), потом готовые.
	Порядок = СтрРазделить("Нужно сопоставить,Проверить,Новый поставщик,Ошибка разбора,Проверить ИНН,Не наш документ,Готов,Создан,Уже загружен", ",");
	Копия = Таблица.Скопировать();
	Копия.Колонки.Добавить("ПорядокСтатуса", Новый ОписаниеТипов("Число"));
	Для Каждого СтрокаТаблицы Из Копия Цикл
		Индекс = Порядок.Найти(СтрокаТаблицы.Статус);
		СтрокаТаблицы.ПорядокСтатуса = ?(Индекс = Неопределено, Порядок.Количество(), Индекс);
	КонецЦикла;
	Копия.Сортировать("ПорядокСтатуса, ИдФайла");
	Копия.Колонки.Удалить("ПорядокСтатуса");
	Возврат Копия;

КонецФункции

&НаСервере
Процедура ПоказатьСтрокиПервогоДокумента()

	Если Документы.Количество() > 0 Тогда
		Элементы.Документы.ТекущаяСтрока = Документы[0].ПолучитьИдентификатор();
		Элементы.Строки.ОтборСтрок = Новый ФиксированнаяСтруктура("ИдФайла", Документы[0].ИдФайла);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Файлы

&НаСервере
Процедура ФайлыИзХранилищаНаСервере(Описания)

	Файлы = Новый Массив;
	Для Каждого Описание Из Описания Цикл
		Файлы.Добавить(Новый Структура("Имя, Данные", ИмяФайлаБезПути(Описание.Имя), ПолучитьИзВременногоХранилища(Описание.Хранение)));
	КонецЦикла;
	ЗапомнитьФайлы(Файлы);

КонецПроцедуры

&НаСервере
Процедура ФайлыИзПапкиНаСервере(Папка)

	Файлы = Новый Массив;
	Найденные = НайтиФайлы(Папка, "*.pdf");
	Имена = Новый СписокЗначений;
	Для Каждого Файл Из Найденные Цикл
		Имена.Добавить(Файл.ПолноеИмя, Файл.Имя);
	КонецЦикла;
	Имена.СортироватьПоПредставлению();
	Для Каждого Элемент Из Имена Цикл
		Файлы.Добавить(Новый Структура("Имя, Данные", Элемент.Представление, Новый ДвоичныеДанные(Элемент.Значение)));
	КонецЦикла;
	ЗапомнитьФайлы(Файлы);

КонецПроцедуры

&НаСервере
Процедура ЗапомнитьФайлы(Файлы)

	ПоместитьВоВременноеХранилище(Файлы, АдресФайлов);
	Имена = Новый Массив;
	Для Каждого Файл Из Файлы Цикл
		Имена.Добавить(Файл.Имя);
	КонецЦикла;
	ВыбраноФайлов = СтрШаблон(НСтр("ru = 'Выбрано файлов: %1. %2'"), Файлы.Количество(), СтрСоединить(Имена, "; "));
	Документы.Очистить();
	Строки.Очистить();
	СводкаДокументов = "";

КонецПроцедуры

&НаСервереБезКонтекста
Функция ИмяФайлаБезПути(Знач Имя)

	Для Каждого Разделитель Из СтрРазделить("\|/", "|") Цикл
		Позиция = СтрНайти(Имя, Разделитель, НаправлениеПоиска.СКонца);
		Если Позиция > 0 Тогда
			Имя = Сред(Имя, Позиция + 1);
		КонецЕсли;
	КонецЦикла;
	Возврат Имя;

КонецФункции

#КонецОбласти

#Область Пакет

&НаСервере
Процедура ЗаписатьОтчетПакета(Ошибка)

	Если ПустаяСтрока(ПутьОтчета) Тогда
		Возврат;
	КонецЕсли;
	Текст = Новый ТекстовыйДокумент;
	Текст.ДобавитьСтроку(СтрШаблон("Документы поставщиков из PDF, %1", Формат(ТекущаяДатаСеанса(), "ДЛФ=DT")));
	Если ЗначениеЗаполнено(Ошибка) Тогда
		Текст.ДобавитьСтроку("ОШИБКА: " + Ошибка);
	КонецЕсли;
	Текст.ДобавитьСтроку(СводкаДокументов);
	Для Каждого Документ Из Документы Цикл
		Если Документ.Статус <> "Создан" Тогда
			Текст.ДобавитьСтроку(СтрШаблон("  %1  %2  %3", Документ.Файл, Документ.Статус, Документ.Пояснение));
		КонецЕсли;
	КонецЦикла;
	Текст.ДобавитьСтроку(Прогресс);
	Текст.Записать(ПутьОтчета, КодировкаТекста.UTF8);

КонецПроцедуры

#КонецОбласти

#Область Настройки

&НаСервере
Функция НастройкиИзФормы()

	Обработка = РеквизитФормыВЗначение("Объект");
	Настройки = Обработка.НовыеНастройки();
	Для Каждого КлючИЗначение Из Настройки Цикл
		Если Элементы.Найти(КлючИЗначение.Ключ) <> Неопределено Или КлючИЗначение.Ключ = "ТаймаутСекунд" Или КлючИЗначение.Ключ = "МаксПопыток" Тогда
			Настройки.Вставить(КлючИЗначение.Ключ, ЭтотОбъект[КлючИЗначение.Ключ]);
		КонецЕсли;
	КонецЦикла;
	Возврат Настройки;

КонецФункции

&НаСервере
Процедура НастройкиВФорму(Настройки)

	Для Каждого КлючИЗначение Из Настройки Цикл
		Если Элементы.Найти(КлючИЗначение.Ключ) <> Неопределено Или КлючИЗначение.Ключ = "ТаймаутСекунд" Или КлючИЗначение.Ключ = "МаксПопыток" Тогда
			ЭтотОбъект[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.СохранитьНастройки(НастройкиИзФормы());

КонецПроцедуры

&НаСервере
Процедура НастроитьОформление()

	Красный = Новый Цвет(200, 30, 30);
	Оранжевый = Новый Цвет(196, 98, 0);
	Зеленый = Новый Цвет(26, 127, 55);
	Синий = Новый Цвет(20, 90, 180);
	Серый = Новый Цвет(110, 110, 110);

	ДобавитьЦветСтатуса("Документы", "Готов", Зеленый);
	ДобавитьЦветСтатуса("Документы", "Создан", Синий);
	ДобавитьЦветСтатуса("Документы", "Уже загружен", Серый);
	ДобавитьЦветСтатуса("Документы", "Нужно сопоставить", Оранжевый);
	ДобавитьЦветСтатуса("Документы", "Новый поставщик", Оранжевый);
	ДобавитьЦветСтатуса("Документы", "Проверить", Оранжевый);
	ДобавитьЦветСтатуса("Документы", "Проверить ИНН", Красный);
	ДобавитьЦветСтатуса("Документы", "Не наш документ", Красный);
	ДобавитьЦветСтатуса("Документы", "Ошибка разбора", Красный);

	ДобавитьЦветСтатуса("Строки", "Найден", Зеленый);
	ДобавитьЦветСтатуса("Строки", "Нужно сопоставить", Оранжевый);
	ДобавитьЦветСтатуса("Строки", "Ошибка в строке", Красный);

КонецПроцедуры

&НаСервере
Процедура ДобавитьЦветСтатуса(Таблица, Статус, Цвет)

	Элемент = УсловноеОформление.Элементы.Добавить();
	Для Каждого Имя Из СтрРазделить(Таблица + "Статус," + Таблица + "Пояснение", ",") Цикл
		Элемент.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(Имя);
	КонецЦикла;
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Таблица + ".Статус");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Статус;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Цвет);

КонецПроцедуры

#КонецОбласти
