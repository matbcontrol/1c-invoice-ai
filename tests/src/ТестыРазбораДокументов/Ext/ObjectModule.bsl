// Автотесты обработки «Документы поставщиков из PDF» против мока Claude API (tools/claude-mock.js).
//
// Запуск через tools/test.ps1: он поднимает мок, восстанавливает базу из эталона до и после
// прогона, поэтому тесты могут создавать документы и контрагентов.
// 1cv8.exe ENTERPRISE /F <база> /Execute ТестыРазбораДокументов.epf /C "Тесты;<обработка.epf>;<каталог invoice-ai>;<отчёт.txt>;<адрес мока>"
//
// Ожидаемые числа берутся из samples/gen/expected.json: их считает генератор образцов
// по данным документов, независимо от кода обработки.

Перем Обработка;
Перем Строки;
Перем Пройдено;
Перем Провалено;
Перем ФайлОтчета;
Перем НачалоПрогона;
Перем НачалоРаздела;
Перем Ожидается;
Перем Настройки;
Перем Каталог;
Перем МокХост;
Перем МокПорт;

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ВыполнитьВсе(ПутьКОбработке, КаталогПроекта, ПутьКОтчету, АдресМока) Экспорт

	Строки = Новый Массив;
	Пройдено = 0;
	Провалено = 0;
	ФайлОтчета = ПутьКОтчету;
	Каталог = КаталогПроекта;
	НачалоПрогона = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка
		Обработка = ВнешниеОбработки.Создать(ПутьКОбработке, Ложь);
		Ожидается = ПрочитатьОжидаемое(Каталог + "\samples\gen\expected.json");
		РазобратьАдресМока(АдресМока);

		Раздел("Правила: ИНН, наименования, арифметика строк");
		ТестыПравил();

		Подготовить(АдресМока);

		Раздел("Запрос к Claude API");
		ТестЗапроса();
		Раздел("Разбор семи документов поставщиков");
		Разбор = ТестРазбора();
		Раздел("Товар выбран вручную, документы созданы");
		ТестСоздания(Разбор);
		Раздел("Повторный разбор: дубли и запомненное соответствие");
		ТестПовторногоРазбора();
		Раздел("Новый поставщик создаётся вместе с документом");
		ТестНовогоПоставщика();
		Раздел("Ошибка в документе поставщика, подтверждённая вручную");
		ТестОшибкиПоставщика();
		Раздел("Документы, которые создавать нельзя");
		ТестЗапрещенных();
		Раздел("Сбои API: 429, 529, 500, отказ модели, обрыв ответа");
		ТестСбоев();
		Раздел("Ключ API");
		ТестКлюча();
		Раздел("Настройки");
		ТестНастроек();
	Исключение
		Провалено = Провалено + 1;
		Строки.Добавить("СБОЙ ТЕСТОВ: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ЗакрытьРаздел();
	СохранитьОтчет(Истина);
	Возврат Провалено = 0;

КонецФункции

#Область Тесты

Процедура ТестыПравил()

	Проверить("ИНН организации 6670365488 верный", Обработка.ИННКорректен("6670365488"), Истина);
	Проверить("ИНН с неверно прочитанной цифрой не проходит", Обработка.ИННКорректен(Ожидается.scanReadInn), Ложь);
	Проверить("ИНН физлица из 12 цифр верный", Обработка.ИННКорректен(Ожидается.inn12Valid), Истина);
	Проверить("12 цифр с неверной последней не проходят", Обработка.ИННКорректен(Ожидается.inn12Invalid), Ложь);
	Проверить("9 цифр не ИНН", Обработка.ИННКорректен("667036548"), Ложь);
	Проверить("буква в ИНН", Обработка.ИННКорректен("66703654O8"), Ложь);
	Проверить("кавычки, регион и лишние пробелы не мешают сравнению",
		Обработка.НормализоватьТекст("Мешки  «Концепция быта» , 120л."), "мешки концепция быта, 120л");

	Строка = Обработка.НоваяТаблицаСтрок().Добавить();
	Строка.Количество = 3;
	Строка.Цена = 33.33;
	Строка.Сумма = 100;
	Строка.СтавкаНДС = "22%";
	Строка.СуммаНДС = 22;
	Строка.Всего = 122;
	Проверить("цена округлена до копеек: 3 × 33,33 = 100,00 не ошибка", Обработка.ОшибкаАрифметикиСтроки(Строка, Ложь), "");
	Строка.Количество = 12;
	Строка.Цена = 45.5;
	Строка.Сумма = 564;
	Ошибка = Обработка.ОшибкаАрифметикиСтроки(Строка, Ложь);
	ПроверитьИстина("12 × 45,50 = 546,00, а в документе 564,00: ошибка с числами",
		СтрНайти(Ошибка, "546,00") > 0 И СтрНайти(Ошибка, "564,00") > 0, Ошибка);
	Строка.Количество = 2;
	Строка.Цена = 105;
	Строка.Сумма = 210;
	Строка.СтавкаНДС = "5%";
	Строка.СуммаНДС = 10;
	Строка.Всего = 210;
	Проверить("цены с НДС 5 %: 10,00 из 210,00", Обработка.ОшибкаАрифметикиСтроки(Строка, Истина), "");
	Строка.СуммаНДС = 10.5;
	ПроверитьИстина("НДС посчитан сверху, хотя цены с НДС: ошибка", Не ПустаяСтрока(Обработка.ОшибкаАрифметикиСтроки(Строка, Истина)), "");

КонецПроцедуры

Процедура ТестЗапроса()

	Данные = Новый ДвоичныеДанные(ПутьКФайлу("upd1"));
	Тело = ИзJSON(Обработка.ТелоЗапроса(Данные, Настройки));
	Проверить("модель по умолчанию", Тело.Получить("model"), "claude-opus-5-5");
	Проверить("max_tokens", Тело.Получить("max_tokens"), 16000);
	Конфиг = Тело.Получить("output_config");
	Проверить("усилие задано явно", Конфиг.Получить("effort"), "high");
	Формат1 = Конфиг.Получить("format");
	Проверить("ответ по JSON-схеме", Формат1.Получить("type"), "json_schema");
	ПроверитьИстина("все объекты схемы закрыты (additionalProperties = false)", ВсеОбъектыЗакрыты(Формат1.Получить("schema")), "");
	Проверить("резервная модель при отказе", Тело.Получить("fallbacks"), "default");
	ПроверитьИстина("temperature, top_p и thinking не передаются",
		Тело.Получить("temperature") = Неопределено И Тело.Получить("top_p") = Неопределено И Тело.Получить("thinking") = Неопределено, "");
	Блок = Тело.Получить("messages")[0].Получить("content")[0];
	Источник = Блок.Получить("source");
	Проверить("PDF документом в base64", Блок.Получить("type") + " " + Источник.Получить("media_type"), "document application/pdf");
	База64 = Источник.Получить("data");
	ПроверитьИстина("base64 без переносов строк", СтрНайти(База64, Символы.ПС) = 0 И СтрНайти(База64, Символы.ВК) = 0, "");
	Проверить("base64 раскодируется в тот же файл", Base64Значение(База64).Размер(), Данные.Размер());

	ЖурналМока(Истина);
	С = Разобрать(ФайлыДокументов("upd1"), Настройки);
	Лог = ЖурналМока();
	Проверить("без ошибок", С.Ошибка, "");
	Проверить("один запрос", Лог.Количество(), 1);
	Если Лог.Количество() > 0 Тогда
		Запись = Лог[0];
		Проверить("версия API", Запись.Получить("version"), "2026-10-21");
		ПроверитьИстина("бета резервной модели в заголовке", СтрНайти(Запись.Получить("beta"), "server-side-fallback-2026-07-01") > 0, Запись.Получить("beta"));
		Проверить("ключ в заголовке x-api-key", Запись.Получить("hasKey"), Истина);
		Проверить("мок узнал файл", Запись.Получить("file"), Ожидается.docs.upd1.file);
	КонецЕсли;

КонецПроцедуры

Функция ТестРазбора()

	Ключи = "upd1,upd2,rdom_err,newsup,otherbuyer,scan,usn";
	ЖурналМока(Истина);
	С = Разобрать(ФайлыДокументов(Ключи), Настройки);
	Проверить("без ошибок", С.Ошибка, "");
	Проверить("запросов к API: по одному на документ", ЖурналМока().Количество(), 7);
	Проверить("документов в таблице", С.Документы.Количество(), 7);

	Д = ДокументПоКлючу(С, "upd1");
	О = Ожидается.docs.upd1;
	Проверить("УПД 1245: номер и дата", Д.Номер + " " + Формат(Д.Дата, "ДФ=dd.MM.yyyy"), О.number + " " + Формат(ДатаИзISO(О.date), "ДФ=dd.MM.yyyy"));
	Проверить("УПД 1245: поставщик найден по ИНН, хотя в 1С у него нет КПП", Строка(Д.Поставщик), "АЛЬФАМАРТ");
	Проверить("УПД 1245: строк", Д.Строк, О.lines);
	Проверить("УПД 1245: всего", Д.Всего, О.totalWithVat);
	Ст = СтрокиДокумента(С, Д);
	Проверить("найдено по артикулу", Сосчитать(Ст, "КакНайдена", "артикул"), О.byArticle);
	Проверить("найдено по штрихкоду", Сосчитать(Ст, "КакНайдена", "штрихкод"), О.byBarcode);
	Проверить("найдено по наименованию: другие кавычки и пробелы", Сосчитать(Ст, "КакНайдена", "наименование"), О.byName);
	Проверить("нового товара нет в 1С", Сосчитать(Ст, "Статус", "Нужно сопоставить"), О.notFound);
	Проверить("товары совпали с теми, что в документе", РасхожденияТоваров(Ст, О.rows), 0);
	Проверить("статус документа", Д.Статус, "Нужно сопоставить");
	Проверить("без отметки «Создать», пока товар не выбран", Д.Применить, Ложь);

	Д = ДокументПоКлючу(С, "upd2");
	Проверить("двухстраничный УПД: все 36 строк с обеих страниц", Д.Строк, Ожидается.docs.upd2.lines);
	Проверить("двухстраничный УПД: всего", Д.Всего, Ожидается.docs.upd2.totalWithVat);

	Д = ДокументПоКлючу(С, "rdom_err");
	Проверить("ошибка поставщика в строке 3: «Проверить»", Д.Статус, "Проверить");
	Ст = СтрокиДокумента(С, Д);
	Ошибочные = Отобрать(Ст, "Статус", "Ошибка в строке");
	Проверить("ошибочная строка", ?(Ошибочные.Количество() = 1, Ошибочные[0].НомерСтроки, 0), Ожидается.docs.rdom_err.wrongLines[0]);
	Строки.Добавить("        " + Д.Пояснение);

	Д = ДокументПоКлючу(С, "newsup");
	Проверить("поставщика нет в 1С", Д.Статус, "Новый поставщик");
	Проверить("без «Создавать поставщиков» сам не создаётся", Д.Применить, Ложь);

	Д = ДокументПоКлючу(С, "otherbuyer");
	Проверить("покупатель другая организация", Д.Статус, "Не наш документ");
	ПроверитьИстина("в пояснении ИНН покупателя из документа", СтрНайти(Д.Пояснение, Ожидается.docs.otherbuyer.buyerInn) > 0, Д.Пояснение);

	Д = ДокументПоКлючу(С, "scan");
	Проверить("скан: цифра ИНН прочитана неверно, контрольная сумма это ловит", Д.Статус, "Проверить ИНН");
	ПроверитьИстина("в пояснении и неверный ИНН, и что модель не уверена",
		СтрНайти(Д.Пояснение, Ожидается.scanReadInn) > 0 И СтрНайти(Д.Пояснение, "не уверена") > 0, Д.Пояснение);
	Строки.Добавить("        " + Д.Пояснение);

	Д = ДокументПоКлючу(С, "usn");
	Проверить("счёт поставщика на УСН: готов", Д.Статус, "Готов");
	Проверить("вид документа", Д.Тип, "Счёт на оплату");
	Проверить("цены с НДС", Д.ЦеныСНДС, Истина);
	Проверить("отмечен к созданию", Д.Применить, Истина);
	Возврат С;

КонецФункции

Процедура ТестСоздания(С)

	Д = ДокументПоКлючу(С, "upd1");
	Новый1 = Отобрать(СтрокиДокумента(С, Д), "Статус", "Нужно сопоставить");
	Если Новый1.Количество() = 1 Тогда
		// Как в форме: пользователь выбрал товар, строка помечена «вручную».
		Новый1[0].Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Ожидается.unknownMapsTo));
		Новый1[0].КакНайдена = "вручную";
	КонецЕсли;
	Обработка.ПроверитьДокументы(С.Документы, С.Строки, Настройки);
	Проверить("после выбора товара документ готов", Д.Статус, "Готов");
	Итог = Обработка.СоздатьДокументы(С.Документы, С.Строки, ФайлыДокументов("upd1,upd2,rdom_err,newsup,otherbuyer,scan,usn"), Настройки);
	Строки.Добавить("  " + ВремяСоздания(Итог));
	Проверить("создано документов: УПД 1245 и счёт ТехноСтрой", Итог.Создано, 2);
	Проверить("ошибок", Итог.Ошибок, 0);

	Накладная = Д.Документ1С;
	О = Ожидается.docs.upd1;
	Проверить("статус", Д.Статус, "Создан");
	Проверить("поставщик", Строка(Накладная.Контрагент), "АЛЬФАМАРТ");
	Проверить("входящий номер и дата", Накладная.НомерВходящегоДокумента + " " + Формат(Накладная.ДатаВходящегоДокумента, "ДФ=dd.MM.yyyy"),
		О.number + " " + Формат(ДатаИзISO(О.date), "ДФ=dd.MM.yyyy"));
	Проверить("склад", Накладная.СтруктурнаяЕдиница, Настройки.Склад);
	Проверить("строк", Накладная.Запасы.Количество(), О.lines);
	Проверить("сумма документа равна итогу УПД", Накладная.СуммаДокумента, О.totalWithVat);
	Проверить("суммы без НДС, НДС сверху", Накладная.СуммаВключаетНДС, Ложь);
	Проверить("ставка НДС", Строка(Накладная.Запасы[0].СтавкаНДС), "22%");
	Проверить("черновик, не проведён", Накладная.Проведен, Ложь);
	Проверить("PDF приложен к накладной", ФайловУДокумента(Накладная), 1);
	Проверить("соответствие для нового товара запомнено", ТоварПоСоответствию(Накладная.Контрагент, Ожидается.unknownCode),
		Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(Ожидается.unknownMapsTo)));

	Д = ДокументПоКлючу(С, "usn");
	Накладная = Д.Документ1С;
	Проверить("счёт на УСН: сумма документа", ?(ЗначениеЗаполнено(Накладная), Накладная.СуммаДокумента, 0), Ожидается.docs.usn.totalWithVat);
	Проверить("счёт на УСН: цены включают НДС", ?(ЗначениеЗаполнено(Накладная), Накладная.СуммаВключаетНДС, Ложь), Истина);
	Проверить("счёт на УСН: ставка 5 %", ?(ЗначениеЗаполнено(Накладная), Строка(Накладная.Запасы[0].СтавкаНДС), ""), "5%");

КонецПроцедуры

Процедура ТестПовторногоРазбора()

	С = Разобрать(ФайлыДокументов("upd1,upd2,usn"), Настройки);
	Проверить("без ошибок", С.Ошибка, "");
	Проверить("УПД 1245 второй раз: уже загружен", ДокументПоКлючу(С, "upd1").Статус, "Уже загружен");
	Проверить("счёт ТехноСтрой второй раз: уже загружен", ДокументПоКлючу(С, "usn").Статус, "Уже загружен");
	Д = ДокументПоКлючу(С, "upd2");
	Ст = СтрокиДокумента(С, Д);
	Проверить("новый товар во втором УПД нашёлся по запомненному соответствию", Сосчитать(Ст, "КакНайдена", "соответствие"), Ожидается.docs.upd2.bySupplierMap);
	Проверить("второй УПД готов без ручной работы", Д.Статус, "Готов");
	Итог = Обработка.СоздатьДокументы(С.Документы, С.Строки, ФайлыДокументов("upd1,upd2,usn"), Настройки);
	Проверить("создан только второй УПД", Итог.Создано, 1);
	Проверить("сумма второго УПД", ?(ЗначениеЗаполнено(Д.Документ1С), Д.Документ1С.СуммаДокумента, 0), Ожидается.docs.upd2.totalWithVat);
	Проверить("строк во втором УПД", ?(ЗначениеЗаполнено(Д.Документ1С), Д.Документ1С.Запасы.Количество(), 0), Ожидается.docs.upd2.lines);
	Проверить("приходных накладных АЛЬФАМАРТ из PDF в базе", НакладныхПоНомерам("1245,1302"), 2);

КонецПроцедуры

Процедура ТестНовогоПоставщика()

	Н = КопияНастроек();
	Н.СоздаватьПоставщиков = Истина;
	С = Разобрать(ФайлыДокументов("newsup"), Н);
	Д = ДокументПоКлючу(С, "newsup");
	Проверить("с «Создавать поставщиков» отмечен к созданию", Д.Применить, Истина);
	Итог = Обработка.СоздатьДокументы(С.Документы, С.Строки, ФайлыДокументов("newsup"), Н);
	Проверить("создан", Итог.Создано, 1);
	Поставщик = Д.Поставщик;
	Проверить("контрагент: ИНН и КПП из документа", ?(ЗначениеЗаполнено(Поставщик), Поставщик.ИНН + "/" + Поставщик.КПП, ""),
		Ожидается.suppliers.hoz.inn + "/" + Ожидается.suppliers.hoz.kpp);
	Проверить("контрагент: краткое имя без «ООО» и кавычек", Строка(Поставщик), "ХозОптТорг");
	Проверить("контрагент помечен поставщиком", ?(ЗначениеЗаполнено(Поставщик), Поставщик.Поставщик, Ложь), Истина);
	Проверить("сумма документа", ?(ЗначениеЗаполнено(Д.Документ1С), Д.Документ1С.СуммаДокумента, 0), Ожидается.docs.newsup.totalWithVat);

КонецПроцедуры

Процедура ТестОшибкиПоставщика()

