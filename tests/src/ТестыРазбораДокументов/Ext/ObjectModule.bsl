// Строки документа приходят массивом: у массива нет НайтиСтроки.
Функция Отобрать(Ряды, Колонка, Значение)

	Результат = Новый Массив;
	Для Каждого Т Из Ряды Цикл
		Если Т[Колонка] = Значение Тогда
			Результат.Добавить(Т);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

