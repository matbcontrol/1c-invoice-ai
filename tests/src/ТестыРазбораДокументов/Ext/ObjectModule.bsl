#Область Данные

Функция ВсеОбъектыЗакрыты(Схема)

	Если ТипЗнч(Схема) <> Тип("Соответствие") Тогда
		Возврат Истина;
	КонецЕсли;
	Если Схема.Получить("type") = "object" Тогда
		Если Схема.Получить("additionalProperties") <> Ложь Тогда
			Возврат Ложь;
		КонецЕсли;
		Свойства = Схема.Получить("properties");
		Если ТипЗнч(Свойства) = Тип("Соответствие") Тогда
			Для Каждого КлючИЗначение Из Свойства Цикл
				Если Не ВсеОбъектыЗакрыты(КлючИЗначение.Значение) Тогда
					Возврат Ложь;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Возврат ВсеОбъектыЗакрыты(Схема.Получить("items"));

КонецФункции

Функция РасхожденияТоваров(СтрокиРазбора, Ряды)

	Расхождений = 0;
	Для Каждого Ряд Из Ряды Цикл
		Найдено = Неопределено;
		Для Каждого Т Из СтрокиРазбора Цикл
			Если Т.НомерСтроки = Ряд.line Тогда
				Найдено = Т;
			КонецЕсли;
		КонецЦикла;
		Если Найдено = Неопределено Тогда
			Расхождений = Расхождений + 1;
			Продолжить;
		КонецЕсли;
		Ожидаемый = ?(ПустаяСтрока(Ряд.uuid), "", Ряд.uuid);
		Фактический = ?(ЗначениеЗаполнено(Найдено.Номенклатура), Строка(Найдено.Номенклатура.УникальныйИдентификатор()), "");
		Если Ожидаемый <> Фактический Или Найдено.Количество <> Ряд.quantity Или Найдено.Сумма <> Ряд.amount Тогда
			Расхождений = Расхождений + 1;
			Строки.Добавить(СтрШаблон("        строка %1: товар %2, ожидался %3", Ряд.line, Найдено.Номенклатура, Ожидаемый));
		КонецЕсли;
	КонецЦикла;
	Возврат Расхождений;

КонецФункции

Функция ФайловУДокумента(Документ)

	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Справочник.ПриходнаяНакладнаяПрисоединенныеФайлы КАК Ф ГДЕ Ф.ВладелецФайла = &Документ");
	Запрос.УстановитьПараметр("Документ", Документ);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;

