Функция ТоварПоСоответствию(Поставщик, Код)

	Запрос = Новый Запрос("ВЫБРАТЬ НП.Номенклатура КАК Номенклатура ИЗ Справочник.НоменклатураПоставщиков КАК НП ГДЕ НП.Владелец = &Поставщик И НП.Идентификатор = &Ключ");
	Запрос.УстановитьПараметр("Поставщик", Поставщик);
	Запрос.УстановитьПараметр("Ключ", Обработка.НормализоватьТекст(Код));
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Номенклатура, Неопределено);

